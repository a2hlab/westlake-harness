ohos_shared_library("apk_installer") {
  sources = [
    "jni/apk_label_resolver.cpp",
    "jni/apk_manifest_parser.cpp",
    "jni/arsc_resolver.cpp",
    "jni/apk_native_inventory.cpp",
    "jni/apk_native_inventory_names.cpp",
