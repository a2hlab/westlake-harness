    "jni/apk_verifier_client.cpp",
    "jni/apk_signature_verifier.cpp",
    "signing_metadata/src/signing_metadata_v1.cpp",
    # Provides the production resources-HAP transform exported through the
    # stable C entry point.  Omitting this file left
    # oh_adapter_build_resources_hap unresolved in a fresh library build.
    "jni/apk_installer.cpp",
    # task #65 launcher-icon unification: normalize (crop transparent margins
    # + scale to fill canvas) at install-time icon extraction. PNG codec is
    # the vendored lodepng (src/adapter/third_party/lodepng).
    "jni/icon_normalize.cpp",
    "../../third_party/lodepng/lodepng.cpp",
    "jni/game_install_plan_wire.cpp",
    "jni/install_prepass_materializer.cpp",
    "jni/prepass_context_wire.cpp",
    # Post-registration app data directory provisioning (appspawn-x sandbox
    # bind-mount sources); exported as oh_adapter_create_app_data_dirs.
    "jni/app_data_dir_provisioner.cpp",
    "jni/oh_adapter_install_apk_c_entry.cpp",
  ]

  include_dirs = [ "../../third_party/lodepng" ]

  configs = [ ":apk_installer_config" ]

  deps = [
    ":fn01_package_authority",
    ":fn01_package_transaction",
    "//third_party/minizip:minizip",
    "//third_party/openssl:libcrypto_shared",
  ]

  external_deps = [
    "hilog:libhilog",
  ]

  part_name = "oh_adapter"
  subsystem_name = "oh_adapter"
}

