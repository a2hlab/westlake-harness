  "source_replacements": {
    "android-source/bionic-android15/libc/async_safe/async_safe_log.cpp": {
      "#include <android/set_abort_message.h>": "#include <info/fatal_message.h>",
      "android_set_abort_message(msg);": "set_fatal_message(msg);",
      "#include <linux/net.h>": "// AArch64 uses __NR_socket directly; SYS_SOCKET is only used by i386."
