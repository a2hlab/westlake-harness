{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://westlake.local/schema/bionic-musl/reliability-baseline.v1.schema.json",
  "title": "M05 Bionic/Musl reliability baseline v1",
  "description": "M05-private normalized evidence. This is not a product or cross-module ABI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "boundary",
    "assessment_kind",
    "evidence_label",
    "product_claim",
    "device_verified",
    "architecture_contract",
    "environment",
    "external_inputs",
    "candidate",
    "runtime_generation_redteam",
    "closure_gates",
    "reliability_matrix",
    "shim_inventory",
    "verdict"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "baseline_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "boundary": {"const": "bionic-musl-unity-independent-verifier"},
    "assessment_kind": {"enum": ["candidate_audit", "verifier_self_test"]},
    "evidence_label": {"enum": ["stub", "build_pass", "real_impl", "device_verified"]},
    "product_claim": {"const": false},
    "device_verified": {"type": "boolean"},
    "architecture_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["three_domains", "bootstrap"],
      "properties": {
        "three_domains": {
          "type": "array",
          "prefixItems": [
            {"const": "oh_musl"},
            {"const": "per_app_bionic"},
            {"const": "typed_bridge"}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "availability", "s1_s7_mapping_available", "missing_evidence"],
          "properties": {
            "path": {"$ref": "#/$defs/repoPath"},
            "availability": {"enum": ["missing", "present"]},
            "sha256": {"$ref": "#/$defs/sha256"},
            "s1_s7_mapping_available": {"type": "boolean"},
            "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "device"],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "tool_receipts"],
          "properties": {
            "description": {"type": "string", "minLength": 1},
            "tool_receipts": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}
          }
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accessed"],
          "properties": {
            "accessed": {"type": "boolean"},
            "serial": {"type": "string", "minLength": 1},
            "boot_id": {"type": "string", "minLength": 1},
            "receipt": {"$ref": "#/$defs/evidenceRef"}
          }
        }
      }
    },
    "external_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "origin_path", "origin_sha256", "local_path", "local_sha256"],
        "properties": {
          "origin": {"enum": ["aosp-14", "openharmony-6.1.0.31-wukong100"]},
          "origin_path": {"type": "string", "minLength": 1},
          "origin_sha256": {"$ref": "#/$defs/sha256"},
          "local_path": {"$ref": "#/$defs/repoPath"},
          "local_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "missing_evidence", "identities", "runtime_readiness"],
      "properties": {
        "availability": {"enum": ["missing", "present"]},
        "generation_token": {"type": "string", "minLength": 1, "maxLength": 256},
        "offline_generation_receipt_schema": {"const": "NativeGenerationReceiptV1"},
        "offline_generation_receipt": {"$ref": "#/$defs/evidenceRef"},
        "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "identities": {"type": "array", "items": {"$ref": "#/$defs/identity"}},
        "runtime_readiness": {"$ref": "#/$defs/runtimeReadiness"}
      }
    },
    "runtime_generation_redteam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "availability",
        "expected_gate_count",
        "transfer_policy",
        "gates",
        "all_pass",
        "missing_evidence"
      ],
      "properties": {
        "source_path": {"$ref": "#/$defs/repoPath"},
        "availability": {"enum": ["missing", "present"]},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "expected_gate_count": {"const": 22},
        "transfer_policy": {"const": "recompute_for_exact_current_generation"},
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate_id", "result", "generation_token", "evidence"],
            "properties": {
              "gate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,95}$"},
              "result": {"enum": ["pass", "fail"]},
              "generation_token": {"type": "string", "minLength": 1},
              "evidence": {"$ref": "#/$defs/evidenceRef"}
            }
          }
        },
        "all_pass": {"type": "boolean"},
        "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "closure_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recursive_provider_closure",
        "strong_undefined_resolution",
        "namespace_isolation",
        "identity_match",
        "common_generation_token",
        "sealed_fd_identity"
      ],
      "properties": {
        "recursive_provider_closure": {"$ref": "#/$defs/gate"},
        "strong_undefined_resolution": {"$ref": "#/$defs/gate"},
        "namespace_isolation": {"$ref": "#/$defs/gate"},
        "identity_match": {"$ref": "#/$defs/gate"},
        "common_generation_token": {"$ref": "#/$defs/gate"},
        "sealed_fd_identity": {"$ref": "#/$defs/gate"}
      }
    },
    "reliability_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_sanitizer_failure_atomicity",
        "pthread_stress",
        "six_entry_guard_tls",
        "namespace_lifecycle",
        "fault_classification",
        "bounded_soak"
      ],
      "properties": {
        "host_sanitizer_failure_atomicity": {"$ref": "#/$defs/gate"},
        "pthread_stress": {"$ref": "#/$defs/gate"},
        "six_entry_guard_tls": {"$ref": "#/$defs/gate"},
        "namespace_lifecycle": {"$ref": "#/$defs/gate"},
        "fault_classification": {"$ref": "#/$defs/gate"},
        "bounded_soak": {"$ref": "#/$defs/gate"}
      }
    },
    "shim_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shim_id", "owner", "reason", "removal_condition", "test_coverage", "scope"],
        "properties": {
          "shim_id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "removal_condition": {"type": "string", "minLength": 1},
          "test_coverage": {"type": "string", "minLength": 1},
          "scope": {"enum": ["app_specific", "common_adapter", "verifier_only"]}
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "device_admission",
        "first_failure_gate",
        "proven",
        "not_proven",
        "failed",
        "next_evidence"
      ],
      "properties": {
        "assessment": {"enum": ["not_evaluated", "fail", "admit"]},
        "device_admission": {"type": "boolean"},
        "first_failure_gate": {"type": "string", "minLength": 1},
        "proven": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "not_proven": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "failed": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "next_evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repoPath": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "path", "sha256", "bytes", "generation_token"],
      "properties": {
        "role": {"enum": ["apk", "unity_dso", "loader", "musl", "typed_bridge", "provider", "tool", "input_manifest", "synthetic"]},
        "kind": {"enum": ["apk", "elf", "manifest", "tool", "synthetic"]},
        "path": {"$ref": "#/$defs/repoPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "generation_token": {"type": "string", "minLength": 1},
        "elf_machine": {"type": "string", "minLength": 1},
        "soname": {"type": "string", "minLength": 1},
        "build_id": {"type": "string", "pattern": "^[0-9A-Fa-f]+$"},
        "apk_entry": {"type": "string", "minLength": 1}
      }
    },
    "runtimeReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "verification_status", "missing_evidence", "failure"],
      "properties": {
        "availability": {"enum": ["missing", "present"]},
        "verification_status": {"enum": ["not_run", "pass", "fail"]},
        "child_receipt_schema": {"const": "ChildRuntimeReadyReceiptV1"},
        "child_receipt": {"$ref": "#/$defs/evidenceRef"},
        "spawn_receipt_schema": {"const": "SpawnBirthReceiptV1"},
        "spawn_receipt": {"$ref": "#/$defs/evidenceRef"},
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pid", "start_seq", "generation_token", "epoch"],
          "properties": {
            "pid": {"type": "integer", "minimum": 1},
            "start_seq": {"type": "string", "minLength": 1},
            "generation_token": {"type": "string", "minLength": 1},
            "epoch": {"type": "string", "minLength": 1}
          }
        },
        "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "failure": {"type": "string"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "metrics", "failure"],
      "properties": {
        "status": {"enum": ["not_run", "blocked", "pass", "fail"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
        "metrics": {
          "type": "object",
          "additionalProperties": {"type": ["integer", "number", "string", "boolean"]}
        },
        "failure": {"type": "string"}
      }
    }
  }
}
