# R45 dynamic-root identity contract.
#
# The bridge/runtime products are rebuilt before Route-A appspawn.  A new host
# must reproduce these exact SHA-256 and ELF Build-ID values before using this
# contract; changed R45 source requires reviewing and updating this one file.
WLAR_ADAPTER_BRIDGE_PATH=/system/android/lib64/liboh_adapter_bridge.so
WLAR_ADAPTER_BRIDGE_SHA256_HEX=7db99e1b760cf843b1a99db1382a3299f189c8cbca786ec411b7c35a2af6ffb9
WLAR_ADAPTER_BRIDGE_BUILD_ID_HEX=9bc8f9913c07181f72cc7ef7a202e1d252f06d12
WLAR_ANDROID_RUNTIME_PATH=/system/android/lib64/liboh_android_runtime.so
WLAR_ANDROID_RUNTIME_SHA256_HEX=9689ce764083b4f6db848b036ff292cdd4962ecb2e1ca26373850390efb42812
WLAR_ANDROID_RUNTIME_BUILD_ID_HEX=db3066fabfdfaca69028f9f35da9530d20ccf5de
# Non-authoritative HelloWorld P0 experiment; all ten callbacks typed-reject.
WLASC_P0_TYPED_REJECT_CAPABILITIES=1
