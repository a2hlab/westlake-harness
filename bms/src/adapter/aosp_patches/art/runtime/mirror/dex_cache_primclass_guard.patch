 inline Class* DexCache::GetResolvedType(dex::TypeIndex type_idx) {
-  return GetResolvedTypesEntry(type_idx.index_);
+  Class* resolved = GetResolvedTypesEntry(type_idx.index_);
+  // R155 compatibility: an image cache can contain a non-primitive class for
+  // a primitive descriptor. Treat that entry as unresolved so ClassLinker
+  // resolves the descriptor instead of accepting the incompatible class.
+  if (resolved != nullptr && !resolved->IsPrimitive()) {
+    const char* descriptor = GetDexFile()->GetTypeDescriptor(GetDexFile()->GetTypeId(type_idx));
+    if (descriptor[0] != '\0' && descriptor[1] == '\0') {
+      static std::atomic<bool> logged_primclass_guard{false};
+      if (!logged_primclass_guard.exchange(true)) {
+        LOG(ERROR) << "[PRIMCLASS-GUARD] dropped poisoned DexCache slot for primitive descriptor '"
+                   << descriptor << "' type_idx=" << type_idx.index_;
+      }
+      return nullptr;
+    }
+  }
+  return resolved;
 }
 
