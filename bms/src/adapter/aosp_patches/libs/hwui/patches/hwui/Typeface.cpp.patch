+struct OhFontHandle {
+    SkTypeface* skTypeface;
+    void* data;
+    unsigned size;
+    const char* path;
+};
+
+extern "C" int oh_create_default_skia_handle(OhFontHandle* out);
+extern "C" int oh_typeface_is_child(void);
+
+const Typeface* getOhosDefaultTypeface() {
+    // Do not initialize this singleton in the appspawn parent. The helper is
+    // intentionally child-gated so its C++ static guard cannot be poisoned
+    // by a failed pre-fork attempt.
+    LOG_ALWAYS_FATAL_IF(oh_typeface_is_child() != 1,
+                        "OH default Typeface requested before child fork");
+    if (oh_typeface_is_child() != 1) {
+        return nullptr;
+    }
+
+    static Typeface* const ohDefault = []() -> Typeface* {
+        OhFontHandle handle = {};
+        const int rc = oh_create_default_skia_handle(&handle);
+        if (rc != 0 || handle.skTypeface == nullptr || handle.data == nullptr ||
+            handle.size == 0 || handle.path == nullptr) {
+            std::fprintf(stderr,
+                         "[OH-TF] default SkTypeface failed rc=%d tf=%p data=%p size=%u path=%p\n",
+                         rc, static_cast<void*>(handle.skTypeface), handle.data, handle.size,
+                         static_cast<const void*>(handle.path));
+            return nullptr;
+        }
+
+        sk_sp<SkTypeface> skTypeface(handle.skTypeface);
+        std::vector<minikin::FontVariation> axes;
+        std::shared_ptr<minikin::MinikinFont> minikinFont =
+                std::make_shared<MinikinFontSkia>(std::move(skTypeface), fonts::getNewSourceId(),
+                                                  handle.data, handle.size, handle.path, 0, axes);
+        std::shared_ptr<minikin::Font> font = minikin::Font::Builder(minikinFont).build();
+        if (font == nullptr) {
+            std::fprintf(stderr, "[OH-TF] Minikin Font build failed for %s\n", handle.path);
+            return nullptr;
+        }
+
+        std::vector<std::shared_ptr<minikin::Font>> fonts;
+        fonts.push_back(std::move(font));
+        std::shared_ptr<minikin::FontFamily> family =
+                minikin::FontFamily::create(std::move(fonts));
+        if (family == nullptr) {
+            std::fprintf(stderr, "[OH-TF] FontFamily build failed for %s\n", handle.path);
+            return nullptr;
+        }
+
+        std::vector<std::shared_ptr<minikin::FontFamily>> families;
+        families.push_back(std::move(family));
+        std::shared_ptr<minikin::FontCollection> collection =
+                minikin::FontCollection::create(std::move(families));
+        if (collection == nullptr || collection->getFamilyCount() == 0) {
+            std::fprintf(stderr, "[OH-TF] FontCollection build failed for %s\n", handle.path);
+            return nullptr;
+        }
+
+        Typeface* result = new Typeface();
+        result->fFontCollection = std::move(collection);
+        result->fAPIStyle = Typeface::kNormal;
+        result->fBaseWeight = SkFontStyle::kNormal_Weight;
+        result->fStyle = minikin::FontStyle();
+        std::fprintf(stderr,
+                     "[OH-TF] real default ready path=%s bytes=%u collection=%p families=%zu\n",
+                     handle.path, handle.size, static_cast<void*>(result->fFontCollection.get()),
+                     result->fFontCollection->getFamilyCount());
+        return result;
+    }();
+
+    return ohDefault;
+}
