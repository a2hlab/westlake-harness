+// existing Mission's stack instead of creating a new Mission.  Replaces the
+// no-op draft in mission_list_manager_patch.cpp (which was all #if 0).
+int MissionListManager::StartAbilityInMission(
+    AbilityRequest &abilityRequest, int32_t missionId)
+{
+    // 2026-05-25 1D: NO std::lock_guard here.  This method is only reached from
+    // StartAbility(AbilityRequest&), which already holds managerLock_.  Because
+    // managerLock_ is ffrt::mutex (non-recursive), re-locking deadlocks.  The
+    // previous version locked again — a latent deadlock that never fired because
+    // the __android_in_mission_id path was never actually exercised.
