+    }
+
+    // 2026-05-25 1D Fix 2: mirror MissionListManager::StartAbilityLocked /
+    // MoveMissionToFrontInner EXACTLY -- only the NEW ability is driven to
+    // foreground here; the previous top is NOT eagerly backgrounded.  Native
+    // never calls MoveToBackgroundTask(currentTop) on a forward start: the
+    // previous ability's background is window-driven and fires AFTER the new
+    // ability's first frame (Android "B.onResume then A.onStop" order).
+    // Eagerly backgrounding the previous top here inverted that order and
+    // produced AbilityTransitionDone(BACKGROUND) rc=22 -> "background timeout"
+    // -> KillAppWithReason -> relaunch flicker.  SetPendingState(FOREGROUND)
+    // mirrors GetTargetMission so the AMS state machine serializes this
+    // foreground transition exactly like the native path.  NotifyAbilityToken +
+    // the 5-arg SUPPORT_SCREEN ProcessForegroundAbility complete the window
+    // handshake (window attaches; not the no-screen ProcessForegroundAbility(0)).
+    newRecord->SetPendingState(AbilityState::FOREGROUND);
+    auto callerForFg = GetAbilityRecordByTokenInner(abilityRequest.callerToken);
+    NotifyAbilityToken(newRecord->GetToken(), abilityRequest);
+    newRecord->SetSpecifyTokenId(abilityRequest.specifyTokenId);
+    newRecord->SetAbilityForegroundingFlag();
+#ifdef SUPPORT_SCREEN
+    std::shared_ptr<StartOptions> startOptionsFg = nullptr;
+    newRecord->ProcessForegroundAbility(false, abilityRequest, startOptionsFg, callerForFg,
+        static_cast<uint32_t>(WindowStateChangeReason::ABILITY_CALL));
+#else
+    newRecord->ProcessForegroundAbility(0);
+#endif
+
+    // 2026-06-01 back-stack fix: background the covered previous top AFTER
+    // the new ability is foregrounded (correct order; mirrors native
+    // window-driven background, avoids the inverted-order BACKGROUND rc=22
+    // the 1D note warns about).  Without this Main stays FOREGROUND in OH,
+    // so the back-pop's ProcessForegroundAbility(Main) is a no-op and Main
+    // never gets a FOREGROUND callback -> its window is never re-shown.
+    if (prevTopForBg && prevTopForBg != newRecord &&
+        prevTopForBg->IsAbilityState(AbilityState::FOREGROUND)) {
+        prevTopForBg->SetPendingState(AbilityState::BACKGROUND);
+        MoveToBackgroundTask(prevTopForBg);
+    }
