+// 2026-05-25 1D (P2): bundle-affinity fallback.  Scan all mission lists and
+// return the id of a mission whose stack-top ability belongs to bundleName.
+// Mirrors AOSP RootWindowContainer.findTask matching by taskAffinity (default =
+// package name).  Caller (StartAbility) holds managerLock_, so NO lock here.
+int32_t MissionListManager::FindMissionByBundle(const std::string &bundleName)
+{
+    if (bundleName.empty()) {
+        return -1;
+    }
+    auto matchInList = [&bundleName](const std::shared_ptr<MissionList> &list) -> int32_t {
+        if (!list) {
+            return -1;
+        }
+        for (const auto &mission : list->GetAllMissions()) {
+            if (!mission) {
+                continue;
+            }
+            auto top = mission->GetAbilityRecord();
+            if (top && top->GetElementName().GetBundleName() == bundleName) {
+                return mission->GetMissionId();
+            }
+        }
+        return -1;
+    };
+    for (const auto &missionList : currentMissionLists_) {
+        int32_t id = matchInList(missionList);
+        if (id > 0) {
+            return id;
+        }
+    }
+    int32_t standardId = matchInList(defaultStandardList_);
+    if (standardId > 0) {
+        return standardId;
+    }
+    int32_t singleId = matchInList(defaultSingleList_);
+    if (singleId > 0) {
+        return singleId;
+    }
+    return -1;
+}
