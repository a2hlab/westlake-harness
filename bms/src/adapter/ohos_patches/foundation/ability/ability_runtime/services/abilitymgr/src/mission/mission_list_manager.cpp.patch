+    auto prevTopForBg = targetMission->GetAbilityRecord();
+    targetMission->PushAbility(newRecord);
+    targetMission->SetMultiAbilityMode(true);
+
+    // Move Mission to top of its MissionList so it is the current top.
+    auto missionList = targetMission->GetMissionList();
+    if (missionList) {
