+static bool IsValidBundleName(const std::string &bundleName)
+{
+    if (bundleName.size() < Constants::MIN_BUNDLE_NAME || bundleName.size() > Constants::MAX_BUNDLE_NAME) {
+        return false;
+    }
+    const auto isAsciiAlpha = [](char value) {
+        return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z');
+    };
+    const auto isAsciiDigit = [](char value) {
+        return value >= '0' && value <= '9';
+    };
+    if (!isAsciiAlpha(bundleName.front())) {
+        return false;
+    }
+    return std::all_of(bundleName.begin(), bundleName.end(), [&isAsciiAlpha, &isAsciiDigit](char value) {
+        return isAsciiAlpha(value) || isAsciiDigit(value) || value == '.' || value == '_';
+    });
+}
