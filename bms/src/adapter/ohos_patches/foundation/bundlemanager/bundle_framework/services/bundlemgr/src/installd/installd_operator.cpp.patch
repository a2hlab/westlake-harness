+bool InstalldOperator::ExtractApkNativeFiles(const ExtractParam &extractParam)
+{
+    const std::string stagePrefix = std::string(Constants::BUNDLE_CODE_DIR) +
+        ServiceConstants::PATH_SEPARATOR + ServiceConstants::BUNDLE_NEW_CODE_DIR;
+    const std::string nativeSuffix = std::string("/android/lib/") + extractParam.cpuAbi;
+    const bool hasExactShape = StartsWith(extractParam.targetPath, stagePrefix) &&
+        EndsWith(extractParam.targetPath, nativeSuffix) &&
+        extractParam.targetPath.size() > stagePrefix.size() + nativeSuffix.size();
+    const std::string bundleName = hasExactShape ? extractParam.targetPath.substr(stagePrefix.size(),
+        extractParam.targetPath.size() - stagePrefix.size() - nativeSuffix.size()) : std::string();
+    if (extractParam.srcPath.empty() || extractParam.targetPath.empty() ||
+        (extractParam.cpuAbi != "arm64-v8a" && extractParam.cpuAbi != "armeabi-v7a") ||
+        !hasExactShape || !IsValidBundleName(bundleName) ||
+        extractParam.targetPath != stagePrefix + bundleName + nativeSuffix) {
+        LOG_E(BMS_TAG_INSTALLD, "invalid APK native extraction parameters");
+        return false;
+    }
+
+    class ApkExtractor final : public BundleExtractor {
+    public:
+        explicit ApkExtractor(const std::string &source) : BundleExtractor(source) {}
+        const ZipEntryMap &GetEntries() const
+        {
+            return zipFile_.GetAllEntries();
+        }
+    };
+
+    ApkExtractor extractor(extractParam.srcPath);
+    if (!extractor.Init()) {
+        LOG_E(BMS_TAG_INSTALLD, "APK extractor init failed");
+        return false;
+    }
+    const ZipEntryMap &entries = extractor.GetEntries();
+    if (entries.empty()) {
+        LOG_E(BMS_TAG_INSTALLD, "APK has no ZIP entries");
+        return false;
+    }
+
+    auto failAndClean = [&extractParam](const std::string &reason) {
+        LOG_E(BMS_TAG_INSTALLD, "APK native extraction failed: %{public}s", reason.c_str());
+        (void)DeleteDir(extractParam.targetPath);
+        return false;
+    };
+    if (!DeleteDir(extractParam.targetPath) ||
+        !MkOwnerDir(extractParam.targetPath, 0755, 0, 0)) {
+        return failAndClean("cannot create an empty native stage");
+    }
+    // Hardened vendor SDKs (e.g. MSA OAID) zero e_ident[EI_VERSION]; tolerate
+    // it here only because verifyOutput short-circuits on the CRC match before
+    // checkElf runs, so file content is already authenticated (task #64 B2).
+    auto checkElf = [&extractParam](const std::string &path) {
+        std::ifstream input(path, std::ios::binary);
+        unsigned char ident[EI_NIDENT] = {};
+        if (!input.read(reinterpret_cast<char *>(ident), sizeof(ident)) ||
+            memcmp(ident, ELFMAG, SELFMAG) != 0 || ident[EI_DATA] != ELFDATA2LSB) {
+            return false;
+        }
+        input.clear();
+        input.seekg(0);
+        if (extractParam.cpuAbi == "arm64-v8a") {
+            Elf64_Ehdr header = {};
+            return input.read(reinterpret_cast<char *>(&header), sizeof(header)).good() &&
+                header.e_ident[EI_CLASS] == ELFCLASS64 &&
+                (header.e_ident[EI_VERSION] == EV_CURRENT || header.e_ident[EI_VERSION] == 0) &&
+                header.e_version == EV_CURRENT && header.e_type == ET_DYN && header.e_machine == EM_AARCH64;
+        }
+        Elf32_Ehdr header = {};
+        return input.read(reinterpret_cast<char *>(&header), sizeof(header)).good() &&
+            header.e_ident[EI_CLASS] == ELFCLASS32 &&
+            (header.e_ident[EI_VERSION] == EV_CURRENT || header.e_ident[EI_VERSION] == 0) &&
+            header.e_version == EV_CURRENT && header.e_type == ET_DYN && header.e_machine == EM_ARM;
+    };
+    auto verifyOutput = [&checkElf](const std::string &path, const ZipEntry &entry) {
+        struct stat fileStat = {};
+        if (lstat(path.c_str(), &fileStat) != 0 || !S_ISREG(fileStat.st_mode) ||
+            fileStat.st_uid != 0 || fileStat.st_gid != 0 || (fileStat.st_mode & 0777) != 0755 ||
+            fileStat.st_size < 0 || static_cast<uint64_t>(fileStat.st_size) != entry.uncompressedSize) {
+            return false;
+        }
+        std::ifstream input(path, std::ios::binary);
+        if (!input) {
+            return false;
+        }
+        uLong crc = crc32(0L, Z_NULL, 0);
+        std::vector<char> buffer(BUFFER_SIZE);
+        while (input.read(buffer.data(), buffer.size()) || input.gcount() > 0) {
+            crc = crc32(crc, reinterpret_cast<const Bytef *>(buffer.data()),
+                static_cast<uInt>(input.gcount()));
+        }
+        return !input.bad() && static_cast<uint32_t>(crc) == entry.crc && checkElf(path);
+    };
+
+    ExtractParam fileParam = extractParam;
+    fileParam.extractFileType = ExtractFileType::APK_NATIVE_SO;
+    const std::string prefix = std::string("lib/") + extractParam.cpuAbi +
+        ServiceConstants::PATH_SEPARATOR;
+    constexpr size_t MAX_NATIVE_FILES = 1024;
+    constexpr uint64_t MAX_NATIVE_FILE_BYTES = 1ULL << 30;
+    constexpr uint64_t MAX_NATIVE_TOTAL_BYTES = 4ULL << 30;
+    std::set<std::string> targetNames;
+    size_t extractedCount = 0;
+    uint64_t totalUncompressedSize = 0;
+    for (const auto &entryItem : entries) {
+        const std::string &entryName = entryItem.first;
+        const ZipEntry &entry = entryItem.second;
+        if (!StartsWith(entryName, prefix)) {
+            continue;
+        }
+        if (entryName == prefix) {
+            continue;
+        }
+        const std::string targetName = entryName.substr(prefix.size());
+        if (targetName.empty() || targetName.find(ServiceConstants::PATH_SEPARATOR) != std::string::npos ||
+            !StartsWith(targetName, "lib") || !EndsWith(targetName, ".so") ||
+            !targetNames.insert(targetName).second) {
+            return failAndClean("unsafe or duplicate selected-ABI entry");
+        }
+        const uint64_t entrySize = static_cast<uint64_t>(entry.uncompressedSize);
+        if (entrySize == 0 || entrySize > MAX_NATIVE_FILE_BYTES ||
+            targetNames.size() > MAX_NATIVE_FILES ||
+            totalUncompressedSize > MAX_NATIVE_TOTAL_BYTES - entrySize) {
+            return failAndClean("missing, empty, or excessive ZIP metadata");
+        }
+        totalUncompressedSize += entrySize;
+        if (!ExtractTargetFile(extractor, entryName, fileParam)) {
+            return failAndClean("extract/write/fsync failed");
+        }
+        std::string outputPath = extractParam.targetPath;
+        if (outputPath.back() != ServiceConstants::FILE_SEPARATOR_CHAR) {
+            outputPath.push_back(ServiceConstants::FILE_SEPARATOR_CHAR);
+        }
+        outputPath += targetName;
+        if (!ChangeFileAttr(outputPath, 0, 0) ||
+            !OHOS::ChangeModeFile(outputPath, S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH) ||
+            !verifyOutput(outputPath, entry)) {
+            return failAndClean("CRC/ELF/owner/mode verification failed");
+        }
+        const std::string digest = Sha256File(outputPath);
+        if (digest.empty()) {
+            return failAndClean("SHA-256 failed");
+        }
+        LOG_I(BMS_TAG_INSTALLD, "extracted APK native %{public}s sha256=%{public}s",
+            targetName.c_str(), digest.c_str());
+        ++extractedCount;
+    }
+    if (extractedCount == 0) {
+        return failAndClean("no matching native libraries");
+    }
+    std::set<std::string> actualNames;
+    std::error_code fsError;
+    std::filesystem::directory_iterator iter(extractParam.targetPath, fsError);
+    const std::filesystem::directory_iterator end;
+    while (!fsError && iter != end) {
+        const auto status = std::filesystem::symlink_status(iter->path(), fsError);
+        if (fsError || !std::filesystem::is_regular_file(status) ||
+            !actualNames.insert(iter->path().filename().string()).second) {
+            return failAndClean("native stage contains a non-regular or duplicate output");
+        }
+        iter.increment(fsError);
+    }
+    if (fsError || actualNames != targetNames) {
+        return failAndClean("native stage file set differs from selected ZIP entries");
+    }
+    if (!RestoreconPath(extractParam.targetPath)) {
+        return failAndClean("restorecon failed");
+    }
+    LOG_I(BMS_TAG_INSTALLD, "APK native extraction complete abi=%{public}s count=%{public}zu",
+        extractParam.cpuAbi.c_str(), extractedCount);
+    return true;
+}
+// adapter project: APK_RESOURCES_HAP
+bool InstalldOperator::BuildApkResourcesHap(const std::string &apkPath,
+    const std::string &outHapPath)
+{
+    LOG_I(BMS_TAG_INSTALLD, "BuildApkResourcesHap: apk=%{public}s out=%{public}s",
+        apkPath.c_str(), outHapPath.c_str());
+    if (apkPath.empty() || outHapPath.empty()) {
+        LOG_E(BMS_TAG_INSTALLD, "BuildApkResourcesHap: empty path");
+        return false;
+    }
+    // Cache handle across calls; installd is long-lived so no dlclose.
+    static void *cached = nullptr;
+    static bool tried = false;
+    if (!tried) {
+        tried = true;
+        cached = dlopen("libapk_installer.so", RTLD_NOW | RTLD_GLOBAL);
+        if (cached == nullptr) {
+            LOG_E(BMS_TAG_INSTALLD, "BuildApkResourcesHap: dlopen libapk_installer.so failed: %{public}s",
+                dlerror());
+        }
+    }
+    if (cached == nullptr) {
+        return false;
+    }
+    using BuildFn = int (*)(const char*, const char*);
+    auto fn = reinterpret_cast<BuildFn>(dlsym(cached, "oh_adapter_build_resources_hap"));
+    if (fn == nullptr) {
+        LOG_E(BMS_TAG_INSTALLD, "BuildApkResourcesHap: symbol oh_adapter_build_resources_hap missing");
+        return false;
+    }
+    int rc = fn(apkPath.c_str(), outHapPath.c_str());
+    if (rc != 0) {
+        LOG_E(BMS_TAG_INSTALLD, "BuildApkResourcesHap: synth returned %{public}d", rc);
+        return false;
+    }
+    LOG_I(BMS_TAG_INSTALLD, "BuildApkResourcesHap: OK");
+    return true;
+}
