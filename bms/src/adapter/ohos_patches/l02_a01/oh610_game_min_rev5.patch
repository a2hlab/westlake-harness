+bool WriteAll(int fd, const std::string &payload)
+{
+    size_t offset = 0;
+    while (offset < payload.size()) {
+        const ssize_t count = write(fd, payload.data() + offset, payload.size() - offset);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            return false;
+        }
+        offset += static_cast<size_t>(count);
+    }
+    return true;
+}
+
+bool FsyncDirectory(const char *path)
+{
+    const int fd = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+        return false;
+    }
+    const bool ok = fsync(fd) == 0;
+    return close(fd) == 0 && ok;
+}
+
+bool CreateInstallTxId(std::string &txId)
+{
+    std::array<uint8_t, 16> bytes{};
+    const int fd = open("/dev/urandom", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+        return false;
+    }
+    size_t offset = 0;
+    while (offset < bytes.size()) {
+        const ssize_t count = read(fd, bytes.data() + offset, bytes.size() - offset);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            (void)close(fd);
+            return false;
+        }
+        offset += static_cast<size_t>(count);
+    }
+    if (close(fd) != 0) {
+        return false;
+    }
+    constexpr char HEX[] = "0123456789abcdef";
+    txId.clear();
+    txId.reserve(bytes.size() * 2);
+    for (uint8_t byte : bytes) {
+        txId.push_back(HEX[byte >> 4]);
+        txId.push_back(HEX[byte & 0x0f]);
+    }
+    return true;
+}
+
+bool PersistInstallJournal(const std::string &state, const std::string &txId,
+    const std::string &packageName, const std::string &apkSha256)
+{
+    const std::string temporaryPath = std::string(APK_INSTALL_JOURNAL_PATH) + ".tmp";
+    const std::string payload = "WESTLAKE-APK-INSTALL-JOURNAL-V1\n" + state + "\n" +
+        txId + "\n" + packageName + "\n" + apkSha256 + "\n";
+    const int fd = open(temporaryPath.c_str(),
+        O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd < 0) {
+        return false;
+    }
+    bool ok = WriteAll(fd, payload) && fchmod(fd, 0600) == 0 && fsync(fd) == 0;
+    ok = close(fd) == 0 && ok;
+    if (!ok || rename(temporaryPath.c_str(), APK_INSTALL_JOURNAL_PATH) != 0 ||
+        !FsyncDirectory(APK_INSTALL_JOURNAL_DIR)) {
+        (void)unlink(temporaryPath.c_str());
+        return false;
+    }
+    return true;
+}
+
+bool ClearInstallJournal()
+{
+    if (unlink(APK_INSTALL_JOURNAL_PATH) != 0 && errno != ENOENT) {
+        return false;
+    }
+    return FsyncDirectory(APK_INSTALL_JOURNAL_DIR);
+}
+
+int LoadInstallJournal(std::string &state, std::string &txId,
+    std::string &packageName, std::string &apkSha256)
+{
+    const int fd = open(APK_INSTALL_JOURNAL_PATH, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+        return errno == ENOENT ? 0 : -1;
+    }
+    std::array<char, 1024> buffer{};
+    size_t size = 0;
+    while (size < buffer.size()) {
+        const ssize_t count = read(fd, buffer.data() + size, buffer.size() - size);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count < 0) {
+            (void)close(fd);
+            return -1;
+        }
+        if (count == 0) {
+            break;
+        }
+        size += static_cast<size_t>(count);
+    }
+    char extra = 0;
+    const bool exactEof = size < buffer.size() || read(fd, &extra, 1) == 0;
+    const bool closeOk = close(fd) == 0;
+    if (!exactEof || !closeOk) {
+        return -1;
+    }
+    std::istringstream input(std::string(buffer.data(), size));
+    std::string magic;
+    std::string trailing;
+    if (!std::getline(input, magic) || !std::getline(input, state) ||
+        !std::getline(input, txId) || !std::getline(input, packageName) ||
+        !std::getline(input, apkSha256) || std::getline(input, trailing) ||
+        magic != "WESTLAKE-APK-INSTALL-JOURNAL-V1" ||
+        (state != "PREPARED" && state != "COMMITTED") ||
+        txId.size() != 32 || apkSha256.size() != 64 ||
+        packageName.empty() || packageName.size() >= GAME_INSTALL_PLAN_MAX_PACKAGE_NAME) {
+        return -1;
+    }
+    const auto lowerHex = [](const std::string &value) {
+        return std::all_of(value.begin(), value.end(), [](unsigned char c) {
+            return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+        });
+    };
+    return lowerHex(txId) && lowerHex(apkSha256) ? 1 : -1;
