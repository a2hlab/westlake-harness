+ErrCode InstalldProxy::AtomicPublishVerifiedApk(int sealedFd, const std::string &bundleName,
+    const std::string &txId, const std::string &expectedSha256)
+{
+    const int sealedFdFlags = sealedFd < 0 ? -1 : fcntl(sealedFd, F_GETFD);
+    if (sealedFdFlags < 0 || (sealedFdFlags & FD_CLOEXEC) == 0) {
+        return ERR_APPEXECFWK_INSTALLD_PARAM_ERROR;
+    }
+    MessageParcel data;
+    INSTALLD_PARCEL_WRITE_INTERFACE_TOKEN(data, (GetDescriptor()));
+    const int parcelFdNumber = fcntl(sealedFd, F_DUPFD_CLOEXEC, 3);
+    if (parcelFdNumber < 0) {
+        LOG_E(BMS_TAG_INSTALLD, "atomically duplicate verified APK fd failed, errno:%{public}d", errno);
+        return ERR_APPEXECFWK_PARCEL_ERROR;
+    }
+    sptr<IPCFileDescriptor> parcelFd = new (std::nothrow) IPCFileDescriptor(parcelFdNumber);
+    if (parcelFd == nullptr || !data.WriteObject<IPCFileDescriptor>(parcelFd)) {
+        if (close(parcelFdNumber) != 0) {
+            LOG_W(BMS_TAG_INSTALLD, "close unstaged parcel fd failed, errno:%{public}d", errno);
+        }
+        return ERR_APPEXECFWK_PARCEL_ERROR;
+    }
+    INSTALLD_PARCEL_WRITE(data, String16, Str8ToStr16(bundleName));
+    INSTALLD_PARCEL_WRITE(data, String16, Str8ToStr16(txId));
+    INSTALLD_PARCEL_WRITE(data, String16, Str8ToStr16(expectedSha256));
+
+    MessageParcel reply;
+    MessageOption option(MessageOption::TF_SYNC);
+    return TransactInstalldCmd(InstalldInterfaceCode::ATOMIC_PUBLISH_VERIFIED_APK, data, reply, option);
 }
 
