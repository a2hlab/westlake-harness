+
+bool InstalldOperator::IsManagedApkStagePath(const std::string &path)
+{
+    const std::string androidMarker = "/android";
+    const size_t marker = path.find(androidMarker);
+    if (marker == std::string::npos) {
+        return false;
+    }
+    const std::string bundleRoot = path.substr(0, marker);
+    const std::string androidRoot = bundleRoot + androidMarker;
+    if (path != androidRoot && !StartsWith(path, androidRoot + ServiceConstants::PATH_SEPARATOR)) {
+        return false;
+    }
+    const std::string codePrefix = std::string(Constants::BUNDLE_CODE_DIR) +
+        ServiceConstants::PATH_SEPARATOR;
+    if (!StartsWith(bundleRoot, codePrefix)) {
+        return false;
+    }
+    std::string bundleName = bundleRoot.substr(codePrefix.size());
+    const std::string stagePrefix = ServiceConstants::BUNDLE_NEW_CODE_DIR;
+    if (StartsWith(bundleName, stagePrefix)) {
+        bundleName = bundleName.substr(stagePrefix.size());
+    }
+    return IsValidAndroidPackageName(bundleName) &&
+        (bundleRoot == codePrefix + bundleName ||
+            bundleRoot == codePrefix + stagePrefix + bundleName);
+}
+
+bool InstalldOperator::AtomicPublishVerifiedApk(int sealedFd, const std::string &bundleName,
+    const std::string &txId, const std::string &expectedSha256)
+{
+    if (sealedFd < 0 || !IsValidAndroidPackageName(bundleName) ||
+        !IsLowerHexTxId(txId) || !IsLowerHexSha256(expectedSha256)) {
+        LOG_E(BMS_TAG_INSTALLD, "invalid verified APK publish parameters");
+        return false;
+    }
+    const std::string codeRoot = Constants::BUNDLE_CODE_DIR;
+    const std::string stageRoot = codeRoot + ServiceConstants::PATH_SEPARATOR +
+        ServiceConstants::BUNDLE_NEW_CODE_DIR + bundleName;
+    const std::string finalRoot = codeRoot + ServiceConstants::PATH_SEPARATOR + bundleName;
+    const std::string targetPath = stageRoot + MANAGED_APK_SUFFIX;
+    const std::string finalApkPath = finalRoot + MANAGED_APK_SUFFIX;
+    ManagedApkPath parsed{bundleName, stageRoot};
+    ManagedApkPath finalParsed{bundleName, finalRoot};
+    auto failPublish = [&stageRoot, &finalRoot]() {
+        (void)InstalldOperator::DeleteDir(stageRoot);
+        (void)InstalldOperator::DeleteDir(finalRoot);
+        return false;
+    };
+    const std::string androidDir = stageRoot + "/android";
+
+    struct stat sourceBefore = {};
+    const int sourceSeals = fcntl(sealedFd, F_GET_SEALS);
+    if (sourceSeals < 0 || (sourceSeals & REQUIRED_APK_SEALS) != REQUIRED_APK_SEALS ||
+        fstat(sealedFd, &sourceBefore) != 0 || !S_ISREG(sourceBefore.st_mode) || sourceBefore.st_size <= 0 ||
+        static_cast<uint64_t>(sourceBefore.st_size) > MAX_MANAGED_APK_BYTES) {
+        LOG_E(BMS_TAG_INSTALLD, "verified APK fd is not a bounded fully sealed regular file");
+        return false;
+    }
+    std::string sourceSha256;
+    if (!Sha256FdExact(sealedFd, static_cast<uint64_t>(sourceBefore.st_size), sourceSha256) ||
+        sourceSha256 != expectedSha256) {
+        LOG_E(BMS_TAG_INSTALLD, "sealed APK SHA-256 mismatch");
+        return false;
+    }
+
+    bool stageExists = false;
+    bool finalExists = false;
+    if (!PathExistsNoFollow(stageRoot, stageExists) ||
+        !PathExistsNoFollow(finalRoot, finalExists)) {
+        LOG_E(BMS_TAG_INSTALLD, "cannot inspect managed APK roots");
+        return false;
+    }
+    if (finalExists) {
+        if (!stageExists && VerifyPublishedApk(finalApkPath, expectedSha256) &&
+            VerifyVerificationSentinel(finalParsed, txId, expectedSha256)) {
+            LOG_I(BMS_TAG_INSTALLD, "accepted exact verified APK publish replay");
+            return true;
+        }
+        LOG_E(BMS_TAG_INSTALLD, "divergent verified APK publish replay");
+        return false;
+    }
+    if (stageExists) {
+        LOG_E(BMS_TAG_INSTALLD, "partial verified APK stage exists");
+        (void)InstalldOperator::DeleteDir(stageRoot);
+        return false;
+    }
+    if (mkdir(stageRoot.c_str(), 0755) != 0 ||
+        mkdir(androidDir.c_str(), 0755) != 0 ||
+        chown(stageRoot.c_str(), 0, 0) != 0 ||
+        chown(androidDir.c_str(), 0, 0) != 0 ||
+        !IsTrustedStageDirectory(stageRoot) ||
+        !IsTrustedStageDirectory(androidDir)) {
+        LOG_E(BMS_TAG_INSTALLD, "cannot create trusted verified APK stage");
+        return failPublish();
+    }
+
+    ScopedFd output(open(targetPath.c_str(), O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0400));
+    if (output.Get() < 0) {
+        LOG_E(BMS_TAG_INSTALLD, "cannot create managed base.apk, errno:%{public}d", errno);
+        return failPublish();
+    }
+    auto abortCopy = [&output, &targetPath, &failPublish]() {
+        (void)output.Close();
+        (void)unlink(targetPath.c_str());
+        return failPublish();
+    };
+    std::array<unsigned char, 64 * 1024> buffer{};
+    uint64_t offset = 0;
+    while (offset < static_cast<uint64_t>(sourceBefore.st_size)) {
+        const size_t wanted = static_cast<size_t>(std::min<uint64_t>(
+            buffer.size(), static_cast<uint64_t>(sourceBefore.st_size) - offset));
+        const ssize_t count = pread(sealedFd, buffer.data(), wanted, static_cast<off_t>(offset));
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            LOG_E(BMS_TAG_INSTALLD, "read sealed APK failed, errno:%{public}d", errno);
+            return abortCopy();
+        }
+        size_t written = 0;
+        while (written < static_cast<size_t>(count)) {
+            const ssize_t writeCount = pwrite(output.Get(), buffer.data() + written,
+                static_cast<size_t>(count) - written, static_cast<off_t>(offset + written));
+            if (writeCount < 0 && errno == EINTR) {
+                continue;
+            }
+            if (writeCount <= 0) {
+                LOG_E(BMS_TAG_INSTALLD, "write managed APK failed, errno:%{public}d", errno);
+                return abortCopy();
+            }
+            written += static_cast<size_t>(writeCount);
+        }
+        offset += static_cast<uint64_t>(count);
+    }
+
+    struct stat sourceAfter = {};
+    struct stat targetStat = {};
+    const int sourceSealsAfter = fcntl(sealedFd, F_GET_SEALS);
+    if (fstat(sealedFd, &sourceAfter) != 0 || sourceAfter.st_dev != sourceBefore.st_dev ||
+        sourceAfter.st_ino != sourceBefore.st_ino || sourceAfter.st_size != sourceBefore.st_size ||
+        sourceSealsAfter < 0 || (sourceSealsAfter & REQUIRED_APK_SEALS) != REQUIRED_APK_SEALS ||
+        fchown(output.Get(), 0, 0) != 0 || fchmod(output.Get(), 0444) != 0 || fsync(output.Get()) != 0 ||
+        fstat(output.Get(), &targetStat) != 0 || !S_ISREG(targetStat.st_mode) || targetStat.st_nlink != 1 ||
+        targetStat.st_uid != 0 || targetStat.st_gid != 0 || (targetStat.st_mode & 0777) != 0444 ||
+        targetStat.st_size != sourceBefore.st_size) {
+        LOG_E(BMS_TAG_INSTALLD, "managed APK copy shape or durability gate failed");
+        return abortCopy();
+    }
+    std::string targetSha256;
+    if (!Sha256FdExact(output.Get(), static_cast<uint64_t>(targetStat.st_size), targetSha256) ||
+        targetSha256 != expectedSha256 || !output.Close() ||
+        !WriteVerificationSentinel(parsed, txId, expectedSha256) ||
+        !FsyncDirectory(androidDir) || !FsyncDirectory(stageRoot) ||
+        rename(stageRoot.c_str(), finalRoot.c_str()) != 0 ||
+        !FsyncDirectory(codeRoot)) {
+        LOG_E(BMS_TAG_INSTALLD, "managed APK destination SHA/sentinel gate failed");
+        return abortCopy();
+    }
+    if (!VerifyPublishedApk(finalApkPath, expectedSha256) ||
+        !VerifyVerificationSentinel(finalParsed, txId, expectedSha256)) {
+        LOG_E(BMS_TAG_INSTALLD, "published APK replay identity gate failed");
+        return failPublish();
+    }
+    LOG_I(BMS_TAG_INSTALLD, "atomically published verified APK for %{public}s", bundleName.c_str());
     return true;
 }
 
