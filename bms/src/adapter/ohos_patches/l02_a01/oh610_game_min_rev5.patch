+bool BaseBundleInstaller::RecoverPendingGameInstall()
+{
+#ifndef OH_ADAPTER_ANDROID
+    return true;
+#else
+    std::string recoveryState;
+    std::string recoveryTxId;
+    std::string recoveryPackage;
+    std::string recoveryDigest;
+    const int journalState = LoadInstallJournal(
+        recoveryState, recoveryTxId, recoveryPackage, recoveryDigest);
+    if (journalState < 0) {
+        LOG_E(BMS_TAG_INSTALLER, "malformed APK install journal blocks mutation");
+        return false;
+    }
+    if (journalState == 0) {
+        return true;
+    }
+
+    auto recoveryDataMgr = DelayedSingleton<BundleMgrService>::GetInstance()->GetDataMgr();
+    auto recoveryInstalld = InstalldClient::GetInstance();
+    if (recoveryDataMgr == nullptr || recoveryInstalld == nullptr) {
+        LOG_E(BMS_TAG_INSTALLER, "APK install recovery dependencies unavailable");
+        return false;
+    }
+    const std::string recoveryFinal = std::string(Constants::BUNDLE_CODE_DIR) +
+        ServiceConstants::PATH_SEPARATOR + recoveryPackage;
+    const std::string recoveryStage = std::string(Constants::BUNDLE_CODE_DIR) +
+        ServiceConstants::PATH_SEPARATOR + ServiceConstants::BUNDLE_NEW_CODE_DIR +
+        recoveryPackage;
+    const bool recordExists = recoveryDataMgr->IsBundleExist(recoveryPackage);
+    if (recoveryState == "PREPARED") {
+        if (recordExists) {
+            const InnerBundleInfo *recoveryInfo = nullptr;
+            if (recoveryDataMgr->GetInnerBundleInfoWithFlags(
+                recoveryPackage, 0, recoveryInfo) && recoveryInfo != nullptr) {
+                const auto tokenId = recoveryInfo->GetAccessTokenId(
+                    AccountHelper::GetCurrentActiveUserId());
+                if (tokenId != 0) {
+                    (void)Security::AccessToken::AccessTokenKit::DeleteToken(tokenId);
+                }
+            }
+            const bool uninstallStartOk = recoveryDataMgr->UpdateBundleInstallState(
+                recoveryPackage, InstallState::UNINSTALL_START);
+            const bool uninstallSuccessOk = recoveryDataMgr->UpdateBundleInstallState(
+                recoveryPackage, InstallState::UNINSTALL_SUCCESS);
+            if (!uninstallStartOk || !uninstallSuccessOk) {
+                LOG_E(BMS_TAG_INSTALLER, "cannot remove PREPARED BMS record");
+                return false;
+            }
+        }
+        (void)recoveryInstalld->RemoveDir(recoveryStage, false);
+        (void)recoveryInstalld->RemoveDir(recoveryFinal, false);
+    } else if (!recordExists) {
+        (void)recoveryInstalld->RemoveDir(recoveryStage, false);
+        (void)recoveryInstalld->RemoveDir(recoveryFinal, false);
+    }
+    if (!ClearInstallJournal()) {
+        LOG_E(BMS_TAG_INSTALLER, "cannot complete APK install recovery");
+        return false;
+    }
+    LOG_I(BMS_TAG_INSTALLER, "recovered APK journal state %{public}s tx=%{public}s",
+        recoveryState.c_str(), recoveryTxId.c_str());
+    return true;
+#endif
+}
