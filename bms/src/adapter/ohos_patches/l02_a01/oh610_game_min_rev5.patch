+ErrCode InstalldClient::AtomicPublishVerifiedApk(int sealedFd, const std::string &bundleName,
+    const std::string &txId, const std::string &expectedSha256)
+{
+    bool validDigest = expectedSha256.size() == 64;
+    for (char c : expectedSha256) {
+        validDigest = validDigest && ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'));
+    }
+    if (sealedFd < 0 || bundleName.empty() || txId.empty() || !validDigest) {
+        return ERR_APPEXECFWK_INSTALLD_PARAM_ERROR;
+    }
+    return CallService(&IInstalld::AtomicPublishVerifiedApk, sealedFd, bundleName, txId, expectedSha256);
+}
