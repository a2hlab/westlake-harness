+ErrCode InstalldClient::CopyVerifiedApkFromFd(int sealedFd, const std::string &targetPath,
+    const std::string &expectedSha256)
+{
+    bool validDigest = expectedSha256.size() == 64;
+    for (char c : expectedSha256) {
+        validDigest = validDigest && ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'));
+    }
+    if (sealedFd < 0 || targetPath.empty() || !validDigest) {
+        return ERR_APPEXECFWK_INSTALLD_PARAM_ERROR;
+    }
+    return CallService(&IInstalld::CopyVerifiedApkFromFd, sealedFd, targetPath, expectedSha256);
+}
