+class ScopedFd final {
+public:
+    explicit ScopedFd(int fd) : fd_(fd) {}
+    ScopedFd(const ScopedFd &) = delete;
+    ScopedFd &operator=(const ScopedFd &) = delete;
+    ~ScopedFd()
+    {
+        if (fd_ >= 0) {
+            (void)close(fd_);
+        }
+    }
+    int Get() const
+    {
+        return fd_;
+    }
+    bool Close()
+    {
+        if (fd_ < 0) {
+            return true;
+        }
+        const int fd = fd_;
+        fd_ = -1;
+        return close(fd) == 0;
+    }
+
+private:
