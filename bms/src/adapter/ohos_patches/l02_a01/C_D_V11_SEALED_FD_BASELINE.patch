+    SHA256_CTX sha256;
+    if (SHA256_Init(&sha256) != 1) {
+        return false;
+    }
+    std::array<unsigned char, 64 * 1024> buffer{};
+    uint64_t offset = 0;
+    while (offset < expectedSize) {
+        const size_t wanted = static_cast<size_t>(std::min<uint64_t>(buffer.size(), expectedSize - offset));
+        const ssize_t count = pread(fd, buffer.data(), wanted, static_cast<off_t>(offset));
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0 || SHA256_Update(&sha256, buffer.data(), static_cast<size_t>(count)) != 1) {
+            return false;
+        }
+        offset += static_cast<uint64_t>(count);
+    }
+    unsigned char extra = 0;
+    ssize_t extraCount;
+    do {
+        extraCount = pread(fd, &extra, 1, static_cast<off_t>(expectedSize));
+    } while (extraCount < 0 && errno == EINTR);
+    if (extraCount != 0) {
+        return false;
+    }
+
+    std::array<unsigned char, SHA256_DIGEST_LENGTH> digest{};
+    if (SHA256_Final(digest.data(), &sha256) != 1) {
+        return false;
+    }
+    char actualHex[SHA256_DIGEST_LENGTH * 2 + 1] = {};
+    for (size_t i = 0; i < digest.size(); ++i) {
+        if (snprintf(actualHex + (i * 2), sizeof(actualHex) - (i * 2), "%02x", digest[i]) != 2) {
+            return false;
+        }
+    }
+    digestHex = actualHex;
+    return true;
+}
+
+bool VerifyManagedApkFile(const ExtractParam &extractParam, ManagedApkPath &parsed)
+{
+    if (!ParseManagedApkPath(extractParam.srcPath, parsed) ||
+        !IsLowerHexSha256(extractParam.expectedApkSha256)) {
+        return false;
+    }
+
+    int fd = open(extractParam.srcPath.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+        return false;
+    }
+    struct stat before = {};
+    if (fstat(fd, &before) != 0 || !S_ISREG(before.st_mode) || before.st_nlink != 1 ||
+        before.st_uid != 0 || before.st_gid != 0 || before.st_size <= 0 ||
+        static_cast<uint64_t>(before.st_size) > MAX_MANAGED_APK_BYTES ||
+        (before.st_mode & 0777) != 0444) {
+        close(fd);
+        return false;
+    }
+    std::string actualHex;
+    struct stat after = {};
+    if (!Sha256FdExact(fd, static_cast<uint64_t>(before.st_size), actualHex) ||
+        fstat(fd, &after) != 0 || after.st_dev != before.st_dev || after.st_ino != before.st_ino ||
+        after.st_size != before.st_size || after.st_uid != before.st_uid || after.st_gid != before.st_gid ||
+        (after.st_mode & 0777) != 0444 || extractParam.expectedApkSha256 != actualHex) {
+        close(fd);
+        return false;
+    }
+    return close(fd) == 0;
+}
+
+bool WriteVerificationSentinel(const ManagedApkPath &parsed, const std::string &expectedSha256)
+{
+    const std::string expectedPath = parsed.stageRoot + APK_VERIFY_SENTINEL_SUFFIX;
+    const std::string payload = std::string(APK_VERIFY_SENTINEL_MAGIC) +
+        expectedSha256 + "\n";
+    int fd = open(expectedPath.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0400);
+    if (fd < 0) {
+        return false;
+    }
+    size_t offset = 0;
+    bool ok = true;
+    while (offset < payload.size()) {
+        const ssize_t count = write(fd, payload.data() + offset, payload.size() - offset);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            ok = false;
+            break;
+        }
+        offset += static_cast<size_t>(count);
+    }
+    if (ok && fchown(fd, 0, 0) != 0) {
+        ok = false;
+    }
+    if (ok && fchmod(fd, 0444) != 0) {
+        ok = false;
+    }
+    if (ok && fsync(fd) != 0) {
+        ok = false;
+    }
+    const int closeResult = close(fd);
+    fd = -1;
+    ok = ok && closeResult == 0;
+    if (!ok) {
+        (void)unlink(expectedPath.c_str());
+        return false;
+    }
+    struct stat sentinelStat = {};
+    return lstat(expectedPath.c_str(), &sentinelStat) == 0 && S_ISREG(sentinelStat.st_mode) &&
+        sentinelStat.st_uid == 0 && sentinelStat.st_gid == 0 && (sentinelStat.st_mode & 0777) == 0444 &&
+        static_cast<uint64_t>(sentinelStat.st_size) == payload.size();
+}
+
+bool VerifyVerificationSentinel(const ManagedApkPath &parsed, const std::string &expectedSha256)
+{
+    const std::string path = parsed.stageRoot + APK_VERIFY_SENTINEL_SUFFIX;
+    const std::string expected = std::string(APK_VERIFY_SENTINEL_MAGIC) + expectedSha256 + "\n";
+    ScopedFd sentinel(open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW));
+    struct stat value = {};
+    if (sentinel.Get() < 0 || fstat(sentinel.Get(), &value) != 0 || !S_ISREG(value.st_mode) ||
+        value.st_nlink != 1 || value.st_uid != 0 || value.st_gid != 0 || (value.st_mode & 0777) != 0444 ||
+        static_cast<uint64_t>(value.st_size) != expected.size()) {
+        return false;
+    }
+    std::string actual(expected.size(), '\0');
+    size_t offset = 0;
+    while (offset < actual.size()) {
+        const ssize_t count = pread(sentinel.Get(), actual.data() + offset, actual.size() - offset,
+            static_cast<off_t>(offset));
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            return false;
+        }
+        offset += static_cast<size_t>(count);
+    }
+    unsigned char extra = 0;
+    return pread(sentinel.Get(), &extra, 1, static_cast<off_t>(actual.size())) == 0 && actual == expected;
+}
+
+bool PathExistsNoFollow(const std::string &path, bool &exists)
+{
+    struct stat value = {};
+    if (lstat(path.c_str(), &value) == 0) {
+        exists = true;
+        return true;
+    }
+    if (errno == ENOENT) {
+        exists = false;
+        return true;
+    }
+    return false;
+}
+
+bool IsTrustedStageDirectory(const std::string &path)
+{
+    struct stat statBuffer = {};
+    return lstat(path.c_str(), &statBuffer) == 0 && S_ISDIR(statBuffer.st_mode) &&
+        statBuffer.st_uid == 0 && statBuffer.st_gid == 0 &&
+        (statBuffer.st_mode & (S_IWGRP | S_IWOTH)) == 0;
+}
+
+bool FsyncDirectory(const std::string &path)
+{
+    ScopedFd directory(open(path.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+    return directory.Get() >= 0 && fsync(directory.Get()) == 0 && directory.Close();
+}
