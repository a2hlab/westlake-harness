+struct ManagedApkPath {
+    std::string bundleName;
+    std::string stageRoot;
+};
+
+bool ParseManagedApkPath(const std::string &path, ManagedApkPath &parsed)
+{
+    const std::string prefix = std::string(Constants::BUNDLE_CODE_DIR) +
+        ServiceConstants::PATH_SEPARATOR + ServiceConstants::BUNDLE_NEW_CODE_DIR;
+    const std::string suffix = MANAGED_APK_SUFFIX;
+    if (!StartsWith(path, prefix) || !EndsWith(path, suffix) ||
+        path.size() <= prefix.size() + suffix.size()) {
+        return false;
+    }
+    const std::string bundleName = path.substr(prefix.size(), path.size() - prefix.size() - suffix.size());
+    const bool validAndroidPackage = bundleName.size() >= Constants::MIN_BUNDLE_NAME &&
+        bundleName.size() <= Constants::MAX_BUNDLE_NAME &&
+        ((bundleName.front() >= 'A' && bundleName.front() <= 'Z') ||
+            (bundleName.front() >= 'a' && bundleName.front() <= 'z')) &&
+        std::all_of(bundleName.begin(), bundleName.end(), [](unsigned char c) {
+            return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+                (c >= '0' && c <= '9') || c == '.' || c == '_';
+        });
+    if (!validAndroidPackage || !InstalldOperator::IsValidBundleName(bundleName)) {
+        return false;
+    }
+    const std::string stageRoot = prefix + bundleName;
+    if (path != stageRoot + suffix) {
+        return false;
+    }
+    parsed.bundleName = bundleName;
+    parsed.stageRoot = stageRoot;
+    return true;
+}
