+bool IsLowerHexSha256(const std::string &digest)
+{
+    return digest.size() == SHA256_DIGEST_LENGTH * 2 &&
+        std::all_of(digest.begin(), digest.end(), [](unsigned char c) {
+            return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+        });
+}
