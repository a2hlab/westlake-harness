-
-    int missing = 0;
-    void* s = g_tls.libssl;
-    WL_TLS_SYM(s, TLS_client_method);      WL_TLS_SYM(s, SSL_CTX_new);
-    WL_TLS_SYM(s, SSL_CTX_load_verify_locations); WL_TLS_SYM(s, SSL_CTX_set_verify);
-    WL_TLS_SYM(s, SSL_new);                WL_TLS_SYM(s, SSL_set_fd);
