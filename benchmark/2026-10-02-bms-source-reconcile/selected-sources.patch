-    g_tls.SSL_CTX_set_verify(g_tls.ctx, 1, nullptr);
-    fprintf(stderr, "[WESTLAKE-441] SSL_CTX ready ca=%s loaded=%d verify=PEER\n", kCaFile, loaded);
