-    }
-
-    g_tls.ctx = g_tls.SSL_CTX_new(g_tls.TLS_client_method());
-    if (g_tls.ctx == nullptr) {
-        fprintf(stderr, "[WESTLAKE-441] SSL_CTX_new FAILED\n");
