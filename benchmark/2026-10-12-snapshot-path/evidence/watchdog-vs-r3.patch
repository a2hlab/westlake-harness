+ cmp -s "$capture_file" "$F/current.jpeg" || io_fail capture_archive_readback_failed
+ [ "$(stat -c '%d:%i' "$capture_file")" = "$capture_identity" ] || io_fail capture_output_identity_changed
+ capture_remove_file
+ capture_context || return 1
 }
