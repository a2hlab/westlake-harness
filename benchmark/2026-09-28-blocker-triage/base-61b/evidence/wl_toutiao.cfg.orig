{
    "services" : [{
            "name" : "wl_toutiao_boot",
            "path" : ["/system/bin/sh", "/data/local/tmp/operator45/boot_toutiao.sh"],
            "once" : 1,
            "secon" : "u:r:su:s0",
            "uid" : "root",
            "gid" : ["root", "shell", "system"]
        }
    ],
    "jobs" : [{
            "name" : "boot",
            "cmds" : ["start wl_toutiao_boot"]
        }
    ]
}
