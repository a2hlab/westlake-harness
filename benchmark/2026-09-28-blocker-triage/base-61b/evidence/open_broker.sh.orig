GREP_DONE
#!/system/bin/sh
# open_broker.sh — privileged on-device broker for the persistent bridge demo (61b06572).
#
# WHY: an OH HAP icon runs as a normal app uid and CANNOT do the bridge launch itself (host_spawn +
# source_app_namespace need root / mount-namespace privilege). This broker runs as ROOT (started by
# `persist_demo.sh up`, nohup), watches world-writable / app-sandbox request points, and does the
# fast open on the HAP's behalf. So the icon only has to DROP A REQUEST; the broker opens the app.
#
# ===================== BROKER CONTRACT (for the HAP author / claude-3) =====================
# To open app KEY, the HAP writes KEY via ANY ONE of these (KEY = the app-key in manifest col1,
# e.g. "wikipedia", OR the package in col4, e.g. "org.wikipedia"):
#   (1) DROP DIR  (preferred, simplest): create a file  /data/local/tmp/persist-demo/reqs/<KEY>
#       (empty file is fine; the filename IS the key). Dir is mode 777.
#   (2) DROP FILE: write one line "<KEY>\n" to  /data/local/tmp/persist-demo/open.req   (mode 666).
#   (3) APP-SANDBOX (most robust if the OH sandbox blocks /data/local/tmp writes): write one line
#       "<KEY>\n" to the HAP's OWN files dir as  wl_open.req  — i.e. context.filesDir + "/wl_open.req".
#       From root that is /data/app/el2/100/base/<HAP_PKG>/haps/<module>/files/wl_open.req; the broker
#       scans all app sandboxes for wl_open.req (excluding the host bundle).
# The broker consumes (deletes/truncates) the request, then opens KEY to the physical first screen
# (kills any other demo app first so exactly one app is shown). ~1 s + first-frame render.
# ==========================================================================================
PDIR=/data/local/tmp/persist-demo
MANIFEST=$PDIR/manifest.txt
REQDIR=$PDIR/reqs
REQFILE=$PDIR/open.req
LOG=$PDIR/broker.log
RTBASE=/data/app/el2/100/base/org.westlake.imehost/files
HOST=org.westlake.imehost
UID_APP=20010053
mkdir -p "$REQDIR"; chmod 777 "$PDIR" "$REQDIR" 2>/dev/null; : > "$REQFILE"; chmod 666 "$REQFILE" 2>/dev/null
echo $$ > "$PDIR/broker.pid"
log(){ echo "$(date '+%m-%d %H:%M:%S') $*" >> "$LOG"; }

# map a key (app-key col1 OR package col4) -> "suffix socket", empty if unknown. No awk/tr on board.
lookup(){
  while read app suffix socket pkg; do
    [ "$app" = "$1" ] && { echo "$suffix $socket"; return 0; }
    [ "$pkg" = "$1" ] && { echo "$suffix $socket"; return 0; }
  done < "$MANIFEST"
}

open_app(){
  ss=$(lookup "$1"); [ -z "$ss" ] && { log "unknown key: $1"; return; }
  set -- $ss; suffix=$1; socket=$2
  rt="$RTBASE/a2hlab-source-$suffix"; stage="/data/local/tmp/a2hlab-app-$suffix"
  [ -d "$rt" ] && [ -x "$stage/source_app_namespace" ] || { log "no runtime $suffix"; return; }
  pidof "$HOST" >/dev/null 2>&1 || { aa start -b "$HOST" -a EntryAbility >/dev/null 2>&1; sleep 3; }
  for p in $(pidof appspawn-x source_app_namespace touchfwd); do kill -9 "$p" 2>/dev/null; done
  sleep 1
  rm -f "/dev/unix/socket/$socket" 2>/dev/null
  WID=$(hidumper -s WindowManagerService -a '-a' 2>/dev/null | grep imehost0 | while read a b c w r; do echo "$w"; break; done)
  case "$WID" in [0-9]*) sed -i "s/export WL_PARENT_ID=[0-9]*/export WL_PARENT_ID=$WID/" "$rt/run.sh";; esac
  nohup "$stage/source_app_namespace" "$rt" "$UID_APP" /system/bin/sh /data/local/tmp/asx/run.sh >"$stage/parent.log" 2>&1 </dev/null &
  n=0; while [ "$n" -lt 60 ]; do [ -S "/dev/unix/socket/$socket" ] && break; sleep 0.25; n=$((n+1)); done
  "$stage/host_spawn" "/dev/unix/socket/$socket" "$stage/request.bin" >>"$LOG" 2>&1
  # The launcher HAP that triggered us is a separate OH app whose window (applauncher0) is on top and
  # would cover the app. Re-front the host window so the app (a sub-window of imehost0) is visible.
  aa start -b "$HOST" -a EntryAbility >/dev/null 2>&1
  power-shell timeout -o 86400000 >/dev/null 2>&1; power-shell wakeup >/dev/null 2>&1
  for i in 1 2 3; do uinput -T -m 600 1700 600 200 300 >/dev/null 2>&1; sleep 1; done
  log "opened $1 (suffix=$suffix wid=$WID)"
}

log "broker start pid=$$ (contract: reqs/<key> | open.req | <sandbox>/files/wl_open.req)"
while :; do
  [ -f "$PDIR/broker.stop" ] && { log "stop"; rm -f "$PDIR/broker.pid"; exit 0; }
  # (1) drop dir: filename = key
  for f in "$REQDIR"/*; do
    [ -e "$f" ] || continue
    key=$(basename "$f"); rm -f "$f"
    log "req(dir): $key"; open_app "$key"
  done
  # (2) drop file: first line = key
  if [ -s "$REQFILE" ]; then
    key=$(head -1 "$REQFILE"); : > "$REQFILE"
    log "req(file): $key"; open_app "$key"
  fi
  # (3) app-sandbox fallback: any HAP's files/open.req or files/wl_open.req (root reads; skip host bundle).
  #     claude-3's launcher (org.westlake.applauncher) writes .../haps/entry/files/open.req since an OH app
  #     sandbox cannot write /data/local/tmp. Match both filenames so any launcher naming works.
  for rq in /data/app/el2/100/base/*/haps/*/files/open.req /data/app/el2/100/base/*/haps/*/files/wl_open.req; do
    [ -s "$rq" ] || continue
    case "$rq" in */$HOST/*) : > "$rq" 2>/dev/null; continue;; esac
    key=$(head -1 "$rq"); : > "$rq" 2>/dev/null; rm -f "$rq" 2>/dev/null
    log "req(sandbox $rq): $key"; open_app "$key"
  done
  sleep 0.7
done
