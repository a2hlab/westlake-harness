rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule cxx
  command = /usr/bin/ccache ../../prebuilts/clang/ohos/linux-x86_64/llvm/bin/clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule alink
  command = rm -f ${out} && "../../prebuilts/clang/ohos/linux-x86_64/llvm/bin/llvm-ar" ${arflags} -r -c -s -D ${out} @"${out}.rsp"
  description = AR ${out}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule link
  command = /usr/bin/env "../../build/toolchain/gcc_link_wrapper.py" --output="${output_dir}/${target_output_name}${output_extension}" --strip="../../prebuilts/clang/ohos/linux-x86_64/llvm/bin/llvm-strip" --unstripped-file="${root_out_dir}/exe.unstripped/${output_dir}/${target_output_name}${output_extension}" --clang-base-dir="/opt/build-trees/oh610_lts_source/prebuilts/clang/ohos"  --mini-debug -- ../../prebuilts/clang/ohos/linux-x86_64/llvm/bin/clang++ ${ldflags} -o "${root_out_dir}/exe.unstripped/${output_dir}/${target_output_name}${output_extension}" obj/third_party/musl/usr/lib/aarch64-linux-ohos/Scrt1.o obj/third_party/musl/usr/lib/aarch64-linux-ohos/crti.o -Wl,--start-group  @"${output_dir}/${target_output_name}${output_extension}.rsp" ${solibs} ${libs} -Wl,--end-group  obj/third_party/musl/usr/lib/aarch64-linux-ohos/crtn.o
  description = LINK ${output_dir}/${target_output_name}${output_extension}
  rspfile = ${output_dir}/${target_output_name}${output_extension}.rsp
  rspfile_content = ${in}
  pool = build_toolchain_link_pool
rule solink
  command = /usr/bin/env "../../build/toolchain/gcc_solink_wrapper.py" --readelf="../../prebuilts/clang/ohos/linux-x86_64/llvm/bin/llvm-readobj" --nm="../../prebuilts/clang/ohos/linux-x86_64/llvm/bin/llvm-nm" --strip=../../prebuilts/clang/ohos/linux-x86_64/llvm/bin/llvm-strip   --sofile="${root_out_dir}/lib.unstripped/${output_dir}/${target_output_name}${output_extension}"  --output="${output_dir}/${target_output_name}${output_extension}" --clang-base-dir="/opt/build-trees/oh610_lts_source/prebuilts/clang/ohos" --mini-debug -- ../../prebuilts/clang/ohos/linux-x86_64/llvm/bin/clang++ -shared ${ldflags} -o "${root_out_dir}/lib.unstripped/${output_dir}/${target_output_name}${output_extension}" @"${output_dir}/${target_output_name}${output_extension}.rsp" -Wl,-soname="${target_output_name}${output_extension}"
  description = SOLINK ${output_dir}/${target_output_name}${output_extension}
  rspfile = ${output_dir}/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive obj/third_party/musl/usr/lib/aarch64-linux-ohos/crti.o ../../prebuilts/clang/ohos/linux-x86_64/llvm/lib/clang/15.0.4/lib/aarch64-linux-ohos/clang_rt.crtbegin.o ${libs} obj/third_party/musl/usr/lib/aarch64-linux-ohos/crtn.o ../../prebuilts/clang/ohos/linux-x86_64/llvm/lib/clang/15.0.4/lib/aarch64-linux-ohos/clang_rt.crtend.o
  pool = build_toolchain_link_pool
  restat = 1
