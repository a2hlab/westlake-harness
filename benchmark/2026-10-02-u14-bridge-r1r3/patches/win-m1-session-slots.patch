 // process-lifetime holder of the session's RSSurfaceNode so the other copy can
 // share the same node (deployed 84695d62 behaviour; single slot like V1).
 constexpr const char* kSharedSurfaceHolderEnv = "WESTLAKE_RS_SURFACE_NODE_HOLDER_PTR_V1";
+// [U14 M1] The V1 slots above hold one session.  With two live windows in one
+// process (launcher Activity + the Activity it starts, a dialog) only the last
+// published session resolves from the other copy, and the earlier window gets an
+// empty Surface (benchmark/2026-10-02-m1-session-slots, 367 lookups / 0
+// violations).  Each session is also published under its own names and read back
+// by the requested session id; V1 stays written and stays the fallback.
+constexpr const char* kSessionNativeWindowEnvPrefix = "WESTLAKE_NATIVE_WINDOW_PTR_V2_";
+constexpr const char* kSessionSurfaceHolderEnvPrefix = "WESTLAKE_RS_SURFACE_NODE_HOLDER_PTR_V2_";
+
+void sessionEnvName(const char* prefix, int32_t sessionId, char* out, size_t size) {
+    std::snprintf(out, size, "%s%d", prefix, sessionId);
+}
+
+void* parseProcessPointer(const char* text) {
+    if (text == nullptr || *text == '\0') return nullptr;
+    char* end = nullptr;
+    errno = 0;
+    unsigned long long value = std::strtoull(text, &end, 0);
+    if (errno != 0 || end == text || *end != '\0' || value == 0) return nullptr;
+    return reinterpret_cast<void*>(static_cast<uintptr_t>(value));
+}
