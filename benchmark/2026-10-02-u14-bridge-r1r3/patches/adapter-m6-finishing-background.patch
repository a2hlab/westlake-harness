+// [U14 M6] Is the Android Activity behind this OH token finishing?
+// ActivityClientControllerAdapter.finishActivity marks the Activity in
+// adapter.core.OhTokenRegistry (markDestroying) before it calls OH
+// TerminateAbility.  OH 6.1 defers that close while the ability's FOREGROUND is
+// still pending and later sends BACKGROUND_NEW; the termination only completes
+// after the app acknowledges BACKGROUND and INITIAL
+// (benchmark/2026-10-02-white-m6-finish-return).  That BACKGROUND_NEW arrives
+// inside the init grace window, so without this check the guard swallows it and
+// the finished Activity's windowless scene stays on top.
+bool FgGuardTokenIsFinishing(JavaVM* jvm, jlong tokenAddr) {
+    if (jvm == nullptr || tokenAddr == 0) return false;
+    ScopedJniAttach attach(jvm);
+    JNIEnv* env = attach.env();
+    if (env == nullptr) return false;
+    bool finishing = false;
+    jclass registry = adapter_bridge_load_class(env, "adapter.core.OhTokenRegistry");
+    if (registry != nullptr) {
+        jmethodID findByOhToken = env->GetStaticMethodID(
+            registry, "findByOhToken", "(J)Landroid/os/IBinder;");
+        jmethodID isDestroying = env->GetStaticMethodID(
+            registry, "isDestroying", "(Landroid/os/IBinder;)Z");
+        if (findByOhToken != nullptr && isDestroying != nullptr) {
+            jobject token = env->CallStaticObjectMethod(registry, findByOhToken, tokenAddr);
+            if (!env->ExceptionCheck() && token != nullptr) {
+                finishing = env->CallStaticBooleanMethod(registry, isDestroying, token) == JNI_TRUE;
+            }
+            if (token != nullptr) env->DeleteLocalRef(token);
+        }
+        env->DeleteLocalRef(registry);
+    }
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+        finishing = false;
+    }
+    return finishing;
+}
