{
  "remote_external_commands": [
    "cat",
    "ps",
    "readlink",
    "stat",
    "/bin/od"
  ],
  "od_argv": [
    "/bin/od",
    "-An",
    "-v",
    "-tx1",
    "-j",
    "EXACT_NONNEGATIVE_OFFSET",
    "-N",
    "EXACT_BOUNDED_COUNT",
    "FIXED_LOG_OR_EXACT_CHILD_CMDLINE"
  ],
  "read_targets": [
    "/proc/sys/kernel/random/boot_id",
    "/proc/uptime",
    "/proc/PARENT/stat",
    "/proc/PARENT/status",
    "/proc/PARENT/fd/1 (readlink)",
    "/proc/PARENT/fd/2 (readlink)",
    "/proc/EXACT_CHILD/stat",
    "/proc/EXACT_CHILD/status",
    "/proc/EXACT_CHILD/cmdline (only exact first-name+NUL byte length)",
    "fixed parent.log",
    "current validated-boot events.log"
  ],
  "shell_builtins": [
    "set",
    "export LC_ALL=C",
    "printf",
    "read",
    "case",
    "for",
    "while",
    "test",
    "arithmetic"
  ],
  "new_dependency": "/bin/od only",
  "forbidden_tools_not_used": [
    "awk",
    "tr",
    "ip",
    "route",
    "wpa_cli",
    "ndc",
    "wc"
  ],
  "device_signals": false,
  "device_writes": false
}
