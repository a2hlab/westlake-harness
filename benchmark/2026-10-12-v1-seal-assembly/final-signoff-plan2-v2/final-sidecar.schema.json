    {
      "if": {
        "properties": {
          "status": {
            "const": "SIGNED_OUTER_REVIEW"
          }
        }
      },
      "then": {
        "properties": {
          "approved_by": {
            "const": "outer(claude)"
          },
          "approved_at": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "properties": {
              "approved_by_outer": {
                "const": true
              }
            }
          },
          "primary_demo_61b": {
            "properties": {
              "ui_acceptance_by_outer": {
                "const": true
              }
            }
          },
          "spare_fingerprint_rehearsal_5cd": {
            "properties": {
              "accepted_by_outer": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
