      "lines": [
        {
          "line": 327,
          "text": "    // [BRIDGED] startService -> OH IAbilityManager.StartAbility (ServiceExtension)"
        },
        {
          "line": 328,
          "text": "    @Override"
        },
        {
          "line": 329,
          "text": "    public ComponentName startService(IApplicationThread caller, Intent service,"
        },
        {
          "line": 330,
          "text": "            String resolvedType, boolean requireForeground, String callingPackage,"
        },
        {
          "line": 331,
          "text": "            String callingFeatureId, int userId) throws RemoteException {"
        },
        {
          "line": 332,
          "text": "        logBridged(\"startService\", \"-> OH IAbilityManager.StartAbility (ServiceExtension)\");"
        },
        {
          "line": 333,
          "text": "        if (service != null) {"
        },
        {
          "line": 334,
          "text": "            IntentWantConverter.WantParams want = IntentWantConverter.intentToWant(service);"
        },
        {
          "line": 335,
          "text": "            // startService has no Activity-token caller — pass 0 (system-caller"
        },
        {
          "line": 336,
          "text": "            // path).  Acceptable because services are not subject to the same"
        },
        {
          "line": 337,
          "text": "            // [ABMS1361] check as activity-to-activity launches."
        },
        {
          "line": 338,
          "text": "            nativeStartAbility(want.bundleName, want.abilityName,"
        },
        {
          "line": 339,
          "text": "                    want.action, want.uri, want.extrasJson, /*callerOhTokenAddr=*/0L);"
        },
        {
          "line": 340,
          "text": "        }"
        },
        {
          "line": 341,
          "text": "        return service != null ? service.getComponent() : null;"
        },
        {
          "line": 342,
          "text": "    }"
        },
        {
          "line": 343,
          "text": ""
        },
        {
          "line": 344,
          "text": "    // [BRIDGED] stopService -> OH IAbilityManager.StopServiceAbility(Want)"
        }
      ]
