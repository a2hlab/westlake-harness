      "id": "finish-result",
      "source": "westlake-harness-walls/bms/src/adapter/framework/activity/java/ActivityClientControllerAdapter.java",
      "sha256": "5b8895ed169cb08bf630e1b0329fe6bdc3babab2da55d113e92382eeb46a4f54",
