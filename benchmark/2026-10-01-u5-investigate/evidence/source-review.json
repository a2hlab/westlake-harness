      "id": "cc-t3-investigate",
      "source": "cc-t3 session scratchpad/investigate.py",
      "sha256": "28aee5c258a65bb2ac23242e9ea5a25b6e7332dd5c8204e163f153801796a985",
      "commit": null,
      "lines": [
        {
          "line": 11,
          "text": "NET=re.compile(r'UnknownHostException|ConnectException|SocketTimeout|failed to connect|getaddrinfo|No address associated|Network is unreachable|okhttp|Retrofit|SSLHandshake|timeout',re.I)"
        },
        {
          "line": 12,
          "text": "PERM=re.compile(r'SecurityException|Permission Denial|requires.*permission|permission denied|not granted|checkSelfPermission',re.I)"
        },
        {
          "line": 13,
          "text": "EXC=re.compile(r'Exception|Error:|Caused by|\\bthrew\\b|NullPointer|IllegalState|UnsupportedOperation|RuntimeException|NoClassDefFound|NoSuchMethod|NoSuchField')"
        },
        {
          "line": 14,
          "text": "STDERR=re.compile(r'C00f00/AppSpawnXJava: \\[stderr\\] (.*)$')"
        },
        {
          "line": 15,
          "text": ""
        },
        {
          "line": 16,
          "text": "def analyze(hp):"
        },
        {
          "line": 17,
          "text": "    app_pid=None"
        },
        {
          "line": 18,
          "text": "    stderr_lines=[]      # (ts, text)"
        },
        {
          "line": 20,
          "text": "    main_last=None"
        },
        {
          "line": 21,
          "text": "    exc=[]               # swallowed exception-ish lines (app stderr)"
        },
        {
          "line": 22,
          "text": "    net=0; perm=0"
        },
        {
          "line": 23,
          "text": "    last_app=None"
        },
        {
          "line": 24,
          "text": "    for ln in open(hp,errors='replace'):"
        },
        {
          "line": 25,
          "text": "        if RENDER.search(ln): render+=1"
        },
        {
          "line": 26,
          "text": "        m=STDERR.search(ln)"
        },
        {
          "line": 27,
          "text": "        if m:"
        },
        {
          "line": 28,
          "text": "            txt=m.group(1).rstrip()"
        },
        {
          "line": 29,
          "text": "            parts=ln.split()"
        },
        {
          "line": 30,
          "text": "            pid=parts[1] if len(parts)>1 else ''"
        },
        {
          "line": 31,
          "text": "            if app_pid is None and ('[B43-BIND]' in txt or 'bindApplication' in txt or '[B8-' in txt):"
        },
        {
          "line": 32,
          "text": "                app_pid=pid"
        },
        {
          "line": 33,
          "text": "            stderr_lines.append(txt)"
        },
        {
          "line": 34,
          "text": "            last_app=txt"
        },
        {
          "line": 35,
          "text": "            if EXC.search(txt): exc.append(txt)"
        },
        {
          "line": 36,
          "text": "            if NET.search(txt): net+=1"
        },
        {
          "line": 37,
          "text": "            if PERM.search(txt): perm+=1"
        },
        {
          "line": 38,
          "text": "    # main thread last: lines where pid==tid==app_pid"
        },
        {
          "line": 39,
          "text": "    if app_pid:"
        },
        {
          "line": 40,
          "text": "        mt=[]"
        },
        {
          "line": 41,
          "text": "        for ln in open(hp,errors='replace'):"
        },
        {
          "line": 42,
          "text": "            p=ln.split()"
        },
        {
          "line": 43,
          "text": "            if len(p)>2 and p[1]==app_pid and p[2]==app_pid:"
        },
        {
          "line": 44,
          "text": "                mt.append(ln.rstrip())"
        },
        {
          "line": 45,
          "text": "        main_last=mt[-1][:150] if mt else None"
        }
      ]
    },
