      "lines": [
        {
          "line": 168,
          "text": "    @Override"
        },
        {
          "line": 169,
          "text": "    public void activityResumed(IBinder token, boolean handleSplashScreenExit) {"
        },
        {
          "line": 170,
          "text": "        if (token == null) {"
        },
        {
          "line": 171,
          "text": "            Log.w(TAG, \"activityResumed: null token\");"
        },
        {
          "line": 172,
          "text": "            return;"
        },
        {
          "line": 173,
          "text": "        }"
        },
        {
          "line": 174,
          "text": "        try {"
        },
        {
          "line": 175,
          "text": "            Long ohAddr = adapter.core.OhTokenRegistry.findOhToken(token);"
        },
        {
          "line": 176,
          "text": "            if (ohAddr == null || ohAddr == 0L) {"
        },
        {
          "line": 177,
          "text": "                Log.w(TAG, \"activityResumed: no OH token mapping for \" + token);"
        },
        {
          "line": 178,
          "text": "                return;"
        },
        {
          "line": 179,
          "text": "            }"
        },
        {
          "line": 180,
          "text": "            long windowGeneration;"
        },
        {
          "line": 181,
          "text": "            synchronized (sForegroundGeneration) {"
        },
        {
          "line": 182,
          "text": "                Long prior = sForegroundGeneration.get(token);"
        },
        {
          "line": 183,
          "text": "                windowGeneration = prior == null ? 1L : prior.longValue() + 1L;"
        },
        {
          "line": 184,
          "text": "                sForegroundGeneration.put(token, windowGeneration);"
        },
        {
          "line": 185,
          "text": "            }"
        },
        {
          "line": 186,
          "text": "            String owner = android.app.ActivityThread.currentPackageName();"
        },
        {
          "line": 187,
          "text": "            if (owner == null || owner.isEmpty()) {"
        },
        {
          "line": 188,
          "text": "                owner = \"unknown.android.owner\";"
        },
        {
          "line": 189,
          "text": "            }"
        },
        {
          "line": 190,
          "text": "            String transitionId = \"foreground:\""
        },
        {
          "line": 191,
          "text": "                    + Integer.toHexString(System.identityHashCode(token))"
        },
        {
          "line": 192,
          "text": "                    + \":\" + windowGeneration;"
        },
        {
          "line": 193,
          "text": "            int rc = nativeOpenForegroundTransition(ohAddr.longValue(), owner,"
        },
        {
          "line": 194,
          "text": "                    System.identityHashCode(token), windowGeneration, transitionId);"
        },
        {
          "line": 195,
          "text": "            if (rc == 0) {"
        },
        {
          "line": 196,
          "text": "                Log.i(TAG, \"Fn03.A10 foreground join open; waiting for typed \""
        },
        {
          "line": 197,
          "text": "                        + \"Fn04.A02 APP_CONTENT receipt transition=\" + transitionId);"
        },
        {
          "line": 198,
          "text": "            } else {"
        },
        {
          "line": 199,
          "text": "                Log.e(TAG, \"Fn03.A10 foreground join rejected rc=\" + rc"
        },
        {
          "line": 200,
          "text": "                        + \" transition=\" + transitionId);"
        },
        {
          "line": 201,
          "text": "            }"
        },
        {
          "line": 202,
          "text": "        } catch (Throwable t) {"
        },
        {
          "line": 203,
          "text": "            Log.e(TAG, \"Fn03.A10 foreground join failed closed\", t);"
        },
        {
          "line": 204,
          "text": "        }"
        },
        {
          "line": 273,
          "text": "    @Override"
        },
        {
          "line": 274,
          "text": "    public boolean finishActivity(IBinder token, int code, Intent data, int finishTask) {"
        },
        {
          "line": 275,
          "text": "        try {"
        },
        {
          "line": 276,
          "text": "            // 2026-05-26 Layer 2 dedup (mission_group_design.html §15): the App is"
        },
        {
          "line": 277,
          "text": "            // finishing this Activity locally, so the reverse ScheduleCleanAbility OH"
        },
        {
          "line": 278,
          "text": "            // sends back must NOT redispatch a second DestroyActivityItem (hazard B)."
        },
        {
          "line": 279,
          "text": "            adapter.core.OhTokenRegistry.markDestroying(token);"
        },
        {
          "line": 280,
          "text": "            // G2.14f — direct BCP call (see reportOhLifecycle for rationale)."
        },
        {
          "line": 281,
          "text": "            Long ohAddr = adapter.core.OhTokenRegistry.findOhToken(token);"
        },
        {
          "line": 282,
          "text": "            if (ohAddr != null && ohAddr != 0L) {"
        },
        {
          "line": 283,
          "text": "                int rc = nativeTerminateAbilityByTokenAddr(ohAddr, code);"
        },
        {
          "line": 284,
          "text": "                Log.i(TAG, \"finishActivity: OH TerminateAbility(token=0x\""
        },
        {
          "line": 285,
          "text": "                        + Long.toHexString(ohAddr) + \", code=\" + code + \") rc=\" + rc);"
        },
        {
          "line": 286,
          "text": "            } else {"
        },
        {
          "line": 287,
          "text": "                Log.w(TAG, \"finishActivity: no OH token mapping for \""
        },
        {
          "line": 288,
          "text": "                        + token + \" — finish-only Android-side\");"
        },
        {
          "line": 289,
          "text": "            }"
        },
        {
          "line": 290,
          "text": "        } catch (Throwable t) {"
        },
        {
          "line": 291,
          "text": "            Log.e(TAG, \"finishActivity reverse callback failed\", t);"
        },
        {
          "line": 292,
          "text": "        }"
        },
        {
          "line": 293,
          "text": "        return true;"
        },
        {
          "line": 294,
          "text": "    }"
        }
      ]
    }
