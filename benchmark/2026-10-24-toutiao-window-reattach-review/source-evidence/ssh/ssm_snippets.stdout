7386: static bool IsValidDigitString(const std::string& windowIdStr)
7387: {
7388:     if (windowIdStr.empty()) {
7389:         return false;
7390:     }
7391:     for (char ch : windowIdStr) {
7392:         if (ch >= '0' && ch <= '9') {
7393:             continue;
7394:         }
7395:         TLOGE(WmsLogTag::DEFAULT, "invalid window id");
7396:         return false;
7397:     }
7398:     return true;
7399: }
