4225:             "isForceClean:%{public}d isUserRequestedExit:%{public}d", persistentId, needRemoveSession, isSaveSnapshot,
4226:             isForceClean, isUserRequestedExit);
4227:         RequestSessionUnfocus(persistentId, FocusChangeReason::SCB_SESSION_REQUEST_UNFOCUS);
4228:         avoidAreaListenerSessionSet_.erase(persistentId);
4229:         screenshotListenerSessionSet_.erase(persistentId);
4230:         screenshotAppEventListenerSessionSet_.erase(persistentId);
4231:         RemoveSessionFromBlackList(sceneSession);
4232:         DestroyDialogWithMainWindow(sceneSession);
4233:         DestroyToastSession(sceneSession);
4234:         DestroySubSession(sceneSession); // destroy sub session by destruction
