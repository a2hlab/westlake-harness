4213:         sceneSession->isRemoving_ = needRemoveSession;
4214:         return WSError::WS_OK;
4215:     }, "MarkRemovingBeforeDestruction");
4216:     auto task = [this, weakSceneSession = wptr(sceneSession), needRemoveSession, isSaveSnapshot, isForceClean,
