=== /opt/build-trees/oh610_lts_source/foundation/window/window_manager/window_scene/session_manager/src/scene_session_manager.cpp:18975,19016
18975: WMError SceneSessionManager::SetParentWindow(int32_t subWindowId, int32_t newParentWindowId)
18976: {
18977:     return taskScheduler_->PostSyncTask([this, subWindowId, newParentWindowId, where = __func__] {
18978:         auto subSession = GetSceneSession(subWindowId);
18979:         if (!subSession || !WindowHelper::IsSubWindow(subSession->GetWindowType())) {
18980:             TLOGNE(WmsLogTag::WMS_SUB, "%{public}s subSession is nullptr or type invalid", where);
18981:             return WMError::WM_ERROR_INVALID_WINDOW;
18982:         }
18983:         int32_t oldParentWindowId = subSession->GetParentPersistentId();
18984:         auto oldParentSession = GetSceneSession(oldParentWindowId);
18985:         if (oldParentSession == nullptr) {
18986:             TLOGNE(WmsLogTag::WMS_SUB, "%{public}s oldParentSession is nullptr", where);
18987:             return WMError::WM_ERROR_INVALID_PARENT;
18988:         }
18989:         auto oldWindowType = oldParentSession->GetWindowType();
18990:         if (!WindowHelper::IsMainWindow(oldWindowType) && !WindowHelper::IsFloatOrSubWindow(oldWindowType)) {
18991:             TLOGNE(WmsLogTag::WMS_SUB, "%{public}s oldParentSession window type invalid", where);
18992:             return WMError::WM_ERROR_INVALID_PARENT;
18993:         }
18994:         auto newParentSession = GetSceneSession(newParentWindowId);
18995:         if (newParentSession == nullptr) {
18996:             TLOGNE(WmsLogTag::WMS_SUB, "%{public}s newParentSession is nullptr", where);
18997:             return WMError::WM_ERROR_INVALID_PARENT;
18998:         }
18999:         TLOGND(WmsLogTag::WMS_SUB, "%{public}s subWindowId: %{public}d oldParentWindowId: %{public}d "
19000:             "newParentWindowId: %{public}d", where, subWindowId, oldParentWindowId, newParentWindowId);
19001:         auto newWindowType = newParentSession->GetWindowType();
19002:         if (!WindowHelper::IsMainWindow(newWindowType) && !WindowHelper::IsFloatOrSubWindow(newWindowType)) {
19003:             TLOGNE(WmsLogTag::WMS_SUB, "%{public}s newParentSession window type invalid", where);
19004:             return WMError::WM_ERROR_INVALID_PARENT;
19005:         }
19006:         if (oldParentSession->GetCallingPid() != newParentSession->GetCallingPid()) {
19007:             TLOGNE(WmsLogTag::WMS_SUB, "%{public}s callingPid not same", where);
19008:             return WMError::WM_ERROR_INVALID_PARENT;
19009:         }
19010:         if (newParentSession->IsAncestorsSession(subWindowId)) {
19011:             TLOGNE(WmsLogTag::WMS_SUB, "%{public}s newParentSession is subsession ancestor", where);
19012:             return WMError::WM_ERROR_INVALID_PARENT;
19013:         }
19014:         return SetParentWindowInner(subSession, oldParentSession, newParentSession);
19015:     });
19016: }
