=== /opt/build-trees/oh610_lts_source/foundation/window/window_manager/window_scene/session_manager/src/scene_session_manager.cpp:5539,5585
5539: WSError SceneSessionManager::DestroyAndDisconnectSpecificSessionInner(const int32_t persistentId)
5540: {
5541:     auto sceneSession = GetSceneSession(persistentId);
5542:     if (sceneSession == nullptr) {
5543:         return WSError::WS_ERROR_NULLPTR;
5544:     }
5545:     auto ret = sceneSession->UpdateActiveStatus(false);
5546:     RemoveSessionFromBlackList(sceneSession);
5547:     WindowDestroyNotifyVisibility(sceneSession);
5548:     auto windowType = sceneSession->GetWindowType();
5549:     if (windowType == WindowType::WINDOW_TYPE_DIALOG) {
5550:         auto parentSession = GetSceneSession(sceneSession->GetParentPersistentId());
5551:         if (parentSession == nullptr) {
5552:             TLOGE(WmsLogTag::WMS_DIALOG, "Dialog not bind parent");
5553:         } else {
5554:             parentSession->RemoveDialogToParentSession(sceneSession);
5555:             parentSession->UnregisterNotifySurfaceBoundsChangeFunc(persistentId);
5556:         }
5557:     } else if (windowType == WindowType::WINDOW_TYPE_TOAST) {
5558:         auto parentSession = GetSceneSession(sceneSession->GetParentPersistentId());
5559:         if (parentSession != nullptr) {
5560:             TLOGD(WmsLogTag::WMS_TOAST, "Find parentSession, id: %{public}d", persistentId);
5561:             parentSession->RemoveToastSession(persistentId);
5562:         } else {
5563:             TLOGW(WmsLogTag::WMS_TOAST, "ParentSession is nullptr, id: %{public}d", persistentId);
5564:         }
5565:     } else if (windowType == WindowType::WINDOW_TYPE_FLOAT) {
5566:         DestroySubSession(sceneSession);
5567:     }
5568:     ret = sceneSession->Disconnect();
5569:     sceneSession->ClearSpecificSessionCbMap();
5570:     if (SessionHelper::IsSubWindow(sceneSession->GetWindowType())) {
5571:         DestroySubSession(sceneSession);
5572:         auto parentSession = GetSceneSession(sceneSession->GetParentPersistentId());
5573:         if (parentSession != nullptr) {
5574:             TLOGD(WmsLogTag::WMS_SUB, "Find parentSession, id: %{public}d", persistentId);
5575:             parentSession->RemoveSubSession(sceneSession->GetPersistentId());
5576:             parentSession->UnregisterNotifySurfaceBoundsChangeFunc(persistentId);
5577:         } else {
5578:             TLOGW(WmsLogTag::WMS_SUB, "ParentSession is nullptr, id: %{public}d", persistentId);
5579:         }
5580:         DestroyUIServiceExtensionSubWindow(sceneSession);
5581:     }
5582:     {
5583:         std::unique_lock<std::shared_mutex> lock(sceneSessionMapMutex_);
5584:         EraseSceneSessionAndMarkDirtyLocked(persistentId);
5585:         systemTopSceneSessionMap_.erase(persistentId);
