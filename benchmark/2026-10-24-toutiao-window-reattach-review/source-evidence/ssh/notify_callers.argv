["ssh", "-o", "BatchMode=yes", "hw248", "p(){ echo \"=== $1:$2,$3\"; awk -v a=$2 -v b=$3 'NR>=a && NR<=b {printf \"%d: %s\\n\", NR, $0}' $1; }; f(){ grep -n \"$2\" $1 | head -3; }; echo '--- enclosing functions (nearest preceding definition)'; for L in 4061 5654 11516; do awk -v L=$L 'NR<=L && /^[A-Za-z].*SceneSessionManager::[A-Za-z]+\\(/ {d=NR\": \"$0} NR==L {print L\" in \"d}' /opt/build-trees/oh610_lts_source/foundation/window/window_manager/window_scene/session_manager/src/scene_session_manager.cpp; done; p /opt/build-trees/oh610_lts_source/foundation/window/window_manager/window_scene/session_manager/src/scene_session_manager.cpp 5640 5660; p /opt/build-trees/oh610_lts_source/foundation/window/window_manager/window_scene/session_manager/src/scene_session_manager.cpp 11500 11522; n=$(grep -n '^void Session::NotifyDisconnect' /opt/build-trees/oh610_lts_source/foundation/window/window_manager/window_scene/session/host/src/session.cpp | cut -d: -f1); p /opt/build-trees/oh610_lts_source/foundation/window/window_manager/window_scene/session/host/src/session.cpp $n $((n+14))"]
