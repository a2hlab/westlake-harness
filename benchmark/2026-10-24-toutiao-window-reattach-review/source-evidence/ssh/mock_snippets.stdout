=== /opt/build-trees/oh610_lts_source/foundation/window/window_manager/wmserver/src/mock_session_manager_service.cpp:176,205
176: int MockSessionManagerService::Dump(int fd, const std::vector<std::u16string>& args)
177: {
178:     TLOGD(WmsLogTag::DEFAULT, "dump begin fd: %{public}d", fd);
179:     if (fd < 0) {
180:         return -1;
181:     }
182:     (void) signal(SIGPIPE, SIG_IGN); // ignore SIGPIPE crash
183:     std::vector<std::string> params;
184:     for (auto& arg : args) {
185:         params.emplace_back(Str16ToStr8(arg));
186:     }
187: 
188:     std::string dumpInfo;
189:     if (params.empty()) {
190:         ShowHelpInfo(dumpInfo);
191:     } else if (params.size() == 1 && params[0] == ARG_DUMP_HELP) { // 1: params num
192:         ShowHelpInfo(dumpInfo);
193:     } else {
194:         int errCode = DumpSessionInfo(params, dumpInfo);
195:         if (errCode != 0) {
196:             ShowIllegalArgsInfo(dumpInfo);
197:         }
198:     }
199:     int ret = write(fd, dumpInfo.c_str(), dumpInfo.length());
200:     if (ret < 0) {
201:         WLOGFE("write error");
202:         return -1; // WMError::WM_ERROR_INVALID_OPERATION;
203:     }
204:     TLOGD(WmsLogTag::DEFAULT, "dump end");
205:     return 0;
