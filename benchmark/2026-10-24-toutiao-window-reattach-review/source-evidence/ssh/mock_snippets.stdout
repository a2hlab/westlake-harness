=== /opt/build-trees/oh610_lts_source/foundation/window/window_manager/wmserver/src/mock_session_manager_service.cpp:717,745
717: int MockSessionManagerService::DumpSessionInfo(const std::vector<std::string>& args, std::string& dumpInfo)
718: {
719:     if (args.empty()) {
720:         return -1;  // WMError::WM_ERROR_INVALID_PARAM;
721:     }
722:     auto sessionManagerService = GetSessionManagerServiceInner(defaultWMSUserId_);
723:     if (sessionManagerService == nullptr) {
724:         WLOGFE("sessionManagerService is nullptr");
725:         return -1;
726:     }
727:     if (!defaultSceneSessionManager_) {
728:         WLOGFW("Get scene session manager ...");
729:         GetSceneSessionManager();
730:         if (!defaultSceneSessionManager_) {
731:             WLOGFW("Get scene session manager proxy failed, nullptr");
732:             return -1;
733:         }
734:     }
735:     sptr<ISceneSessionManager> sceneSessionManagerProxy = iface_cast<ISceneSessionManager>(defaultSceneSessionManager_);
736:     if (sceneSessionManagerProxy == nullptr) {
737:         WLOGFW("sessionManagerServiceProxy is nullptr");
738:         return -1;
739:     }
740:     WSError ret = sceneSessionManagerProxy->GetSessionDumpInfo(args, dumpInfo);
741:     if (ret != WSError::WS_OK) {
742:         WLOGFD("sessionManagerService set success!");
743:         return -1;
744:     }
745:     return 0; // WMError::WM_OK;
