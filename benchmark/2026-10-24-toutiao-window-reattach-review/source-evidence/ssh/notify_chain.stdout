752: WSError SceneSession::DisconnectTask(bool isFromClient, bool isSaveSnapshot)
753: {
754:     auto needSaveSnapshot = !isPersistentImageFit_.load();
755:     PostTask([weakThis = wptr(this), isFromClient, isSaveSnapshot, needSaveSnapshot, where = __func__]()
756:         THREAD_SAFETY_GUARD(SCENE_GUARD) {
757:         auto session = weakThis.promote();
758:         if (!session) {
759:             TLOGNE(WmsLogTag::WMS_LIFE, "%{public}s session is null", where);
760:             return WSError::WS_ERROR_DESTROYED_OBJECT;
761:         }
762:         auto isMainWindow = SessionHelper::IsMainWindow(session->GetWindowType());
763:         if (isMainWindow) {
764:             TLOGNI(WmsLogTag::WMS_LIFE, "%{public}s Notify scene session id: %{public}d paused", where,
765:                 session->GetPersistentId());
766:             session->UpdateLifecyclePausedInner();
767:         }
768:         if (session->sessionInfo_.isPrelaunch_) {
769:             TLOGNI(WmsLogTag::WMS_LIFE, "%{public}s Remove prelaunch session id: %{public}d", where,
770:                 session->GetPersistentId());
771:             session->sessionInfo_.isPrelaunch_ = false;
772:             session->sessionInfo_.frameNum_ = 0;
773:         }
774:         if (isFromClient) {
775:             TLOGNI(WmsLogTag::WMS_LIFE, "%{public}s Client need notify destroy session, id: %{public}d",
776:                 where, session->GetPersistentId());
777:             session->SetSessionState(SessionState::STATE_DISCONNECT);
778:             return WSError::WS_OK;
779:         }
780:         session->SetSnapshotPrivacyMode(session->GetIsPrivacyMode());
781:         auto state = session->GetSessionState();
782:         if ((session->needSnapshot_ || (state == SessionState::STATE_ACTIVE && isMainWindow)) &&
783:             isSaveSnapshot && needSaveSnapshot) {
784:             session->SaveSnapshot(false);
785:         }
786:         session->Session::Disconnect(isFromClient);
787:         session->isTerminating_ = false;
788:         if (session->specificCallback_ != nullptr) {
789:             session->specificCallback_->onHandleSecureSessionShouldHide_(session);
790:             session->isEnableGestureBack_ = true;
791:             session->UpdateGestureBackEnabled();
792:             session->isEnableGestureBackHadSet_ = false;
793:         }
794:         return WSError::WS_OK;
795:     }, __func__);
796:     return WSError::WS_OK;
797: }
