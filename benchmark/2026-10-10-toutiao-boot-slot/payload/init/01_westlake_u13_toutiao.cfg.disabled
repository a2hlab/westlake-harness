{
  "comment": [
    "Additive #91 Toutiao slot matching cc-wiki payload-61b placeholder; install AFTER U13 installer; original wl_toutiao.cfg.disabled stays disabled. No BoatAttack. KILL is required solely for the retained selfheal mechanism, with PID/birth/exe/UID/private-root signal guard. Fresh SELinux/cap admission remains unverified until the approved board window."
  ],
  "jobs": [
    {
      "name": "param:westlake-u13-toutiao-overlay-start",
      "condition": "sys.westlake.demo.u13.ready=true",
      "cmds": [
        "start westlake-u13-toutiao-overlay"
      ]
    }
  ],
  "services": [
    {
      "name": "westlake-u13-toutiao-overlay",
      "path": [
        "/system/bin/sh",
        "/system/etc/westlake-u13-toutiao-overlay.sh"
      ],
      "uid": "root",
      "gid": [
        "root",
        "system"
      ],
      "caps": [
        "DAC_OVERRIDE",
        "CHOWN",
        "FOWNER",
        "SYS_ADMIN",
        "KILL"
      ],
      "start-mode": "condition",
      "once": 1,
      "sandbox": 0,
      "secon": "u:r:su:s0"
    }
  ]
}
