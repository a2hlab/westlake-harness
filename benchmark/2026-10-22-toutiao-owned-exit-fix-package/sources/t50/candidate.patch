+ # Read-only, conservative classification. 3 means confirmed exit; 1 unknown/live.
+ exit_pid=$1; exit_expected=$2
+ case "$exit_pid:$exit_expected" in *[!0-9:]*|:*|*:) exit 1;; esac
+ [ -d "$RB_PROC" ] && [ -r "$RB_PROC" ] && [ -x "$RB_PROC" ] || exit 1
