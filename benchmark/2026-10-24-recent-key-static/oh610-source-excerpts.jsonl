{"path": "/opt/build-trees/oh610_lts_source/test/testfwk/arkxtest/uitest/input/ui_input.cpp", "sha256": "3aff285e89f67322af6dd92c3082c59901d75e41aa7e572444b7d13e4829a182", "lines": [{"line": 197, "text": "    int32_t KeyEventActionInput(int32_t argc, char *argv[], UiDriver &driver, UiOpArgs uiOpArgs)"}, {"line": 198, "text": "    {"}, {"line": 199, "text": "        std::string key = argv[THREE];"}, {"line": 200, "text": "        if (key == \"Home\" && (size_t)argc == INDEX_FOUR) {"}, {"line": 201, "text": "            driver.TriggerKey(Home(), uiOpArgs, exception_);"}, {"line": 202, "text": "        } else if (key == \"Back\" && (size_t)argc == INDEX_FOUR) {"}, {"line": 203, "text": "            driver.TriggerKey(Back(), uiOpArgs, exception_);"}, {"line": 204, "text": "        } else if (key == \"Power\" && (size_t)argc == INDEX_FOUR) {"}, {"line": 205, "text": "            driver.TriggerKey(Power(), uiOpArgs, exception_);"}, {"line": 206, "text": "        } else if (atoi(argv[THREE]) != 0) {"}, {"line": 207, "text": "            int32_t codeZero_ = atoi(argv[THREE]);"}, {"line": 208, "text": "            int32_t codeOne_;"}, {"line": 209, "text": "            int32_t codeTwo_;"}, {"line": 210, "text": "            if ((size_t)argc == INDEX_FOUR) {"}, {"line": 211, "text": "                auto keyAction_ = AnonymousSingleKey(codeZero_);"}, {"line": 212, "text": "                driver.TriggerKey(keyAction_, uiOpArgs, exception_);"}]}
{"path": "/opt/build-trees/oh610_lts_source/test/testfwk/arkxtest/uitest/server/system_ui_controller.cpp", "sha256": "fbf245fdf0c20f6ae60c40427a1b6960af3a901db0dc415e76079beb415c201c", "lines": [{"line": 883, "text": "            if (event.stage_ == ActionStage::UP) {"}, {"line": 884, "text": "                auto iter = std::find(downKeys_.begin(), downKeys_.end(), event.code_);"}, {"line": 885, "text": "                if (iter == downKeys_.end()) {"}, {"line": 886, "text": "                    LOG_W(\"Cannot release a not-pressed key: %{public}d\", event.code_);"}, {"line": 887, "text": "                    continue;"}, {"line": 888, "text": "                }"}, {"line": 889, "text": "                downKeys_.erase(iter);"}, {"line": 890, "text": "                keyEvent->SetKeyCode(event.code_);"}, {"line": 891, "text": "                keyEvent->SetKeyAction(OHOS::MMI::KeyEvent::KEY_ACTION_UP);"}, {"line": 892, "text": "                OHOS::MMI::KeyEvent::KeyItem keyItem;"}, {"line": 893, "text": "                keyItem.SetKeyCode(event.code_);"}, {"line": 894, "text": "                keyItem.SetPressed(false);"}, {"line": 895, "text": "                keyEvent->AddKeyItem(keyItem);"}, {"line": 896, "text": "                keyEvent->SetTargetDisplayId(displayId);"}, {"line": 897, "text": "                InputManager::GetInstance()->SimulateInputEvent(keyEvent);"}, {"line": 898, "text": "                LOG_I(\"Inject keyEvent up, keycode:%{public}d\", event.code_);"}, {"line": 899, "text": "            } else {"}, {"line": 900, "text": "                downKeys_.push_back(event.code_);"}, {"line": 901, "text": "                for (auto downKey : downKeys_) {"}, {"line": 902, "text": "                    keyEvent->SetKeyCode(downKey);"}, {"line": 903, "text": "                    keyEvent->SetKeyAction(OHOS::MMI::KeyEvent::KEY_ACTION_DOWN);"}, {"line": 904, "text": "                    OHOS::MMI::KeyEvent::KeyItem keyItem;"}, {"line": 905, "text": "                    keyItem.SetKeyCode(downKey);"}, {"line": 906, "text": "                    keyItem.SetPressed(true);"}, {"line": 907, "text": "                    keyEvent->AddKeyItem(keyItem);"}, {"line": 908, "text": "                }"}, {"line": 909, "text": "                keyEvent->SetTargetDisplayId(displayId);"}, {"line": 910, "text": "                InputManager::GetInstance()->SimulateInputEvent(keyEvent);"}, {"line": 911, "text": "                LOG_I(\"Inject keyEvent down, keycode:%{public}d\", event.code_);"}]}
