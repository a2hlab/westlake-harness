          "line": 81,
          "text": "INIT_LOCAL_API void *GetSharedMem(const char *fileName, MemHandle *handle, uint32_t spaceSize, int readOnly)"
        },
        {
          "line": 82,
          "text": "{"
        },
        {
          "line": 83,
          "text": "    PARAM_CHECK(fileName != NULL, return NULL, \"Invalid filename or handle\");"
        },
        {
          "line": 84,
          "text": "    int mode = readOnly ? O_RDONLY : O_CREAT | O_RDWR | O_TRUNC;"
        },
        {
          "line": 85,
          "text": "    int fd = open(fileName, mode, S_IRWXU | S_IRWXG | S_IROTH);"
        },
        {
          "line": 86,
          "text": "    PARAM_ONLY_CHECK(fd >= 0, return NULL);"
        },
        {
          "line": 87,
          "text": ""
        },
        {
          "line": 88,
          "text": "    int prot = PROT_READ;"
        },
        {
          "line": 89,
          "text": "    if (!readOnly) {"
        },
        {
          "line": 90,
          "text": "        prot = PROT_READ | PROT_WRITE;"
        },
        {
          "line": 91,
          "text": "        ftruncate(fd, spaceSize);"
        },
        {
          "line": 92,
          "text": "    }"
        },
        {
          "line": 93,
          "text": "    void *areaAddr = (void *)mmap(NULL, spaceSize, prot, MAP_SHARED, fd, 0);"
        },
        {
          "line": 94,
          "text": "    PARAM_CHECK_DUMPE(areaAddr != MAP_FAILED && areaAddr != NULL, close(fd);"
        },
        {
          "line": 95,
          "text": "        return NULL, \"mmap err %d file %s\", errno, fileName);"
        },
        {
          "line": 96,
          "text": "    close(fd);"
        },
        {
          "line": 97,
          "text": "    return areaAddr;"
        }
      ]
    },
