# JIT counterpart of knowledge/toolchains/art-r155/patches/22-dex2oat__implicit-suspend-checks-off.patch:
# JitCompiler copies implicit_suspend_checks_ from the runtime AFTER parsing -Xcompiler-option (jit_compiler.cc:77),
# so it cannot be overridden at launch. Applies to the FZ-005 tree (r1 + 22 patches) for libart-compiler.so only.
--- a/compiler/jit/jit_compiler.cc
+++ b/compiler/jit/jit_compiler.cc
@@ -75,6 +75,11 @@
   compiler_options_->implicit_null_checks_ = runtime->GetImplicitNullChecks();
   compiler_options_->implicit_so_checks_ = runtime->GetImplicitStackOverflowChecks();
   compiler_options_->implicit_suspend_checks_ = runtime->GetImplicitSuspendChecks();
+  // Route-A R155: no suspend-trigger page is kept in x21 and the boot image is compiled with explicit
+  // suspend checks (patch 22, dex2oat.cc:859); JIT code must use the same convention.
+  if (kRuntimeISA == InstructionSet::kArm64) {
+    compiler_options_->implicit_suspend_checks_ = false;
+  }
 
   const InstructionSet instruction_set = compiler_options_->GetInstructionSet();
   if (kRuntimeISA == InstructionSet::kArm) {
