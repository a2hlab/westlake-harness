+                        appRes.abilityName_    = "";
+                        appRes.label_          = appLabel;
+                        appRes.iconNeedParse_  = false;
+                        appRes.labelNeedParse_ = false;
+                        appRes.icon_           = iconDataUri;
+                        if (!iconBytes.empty()) {
