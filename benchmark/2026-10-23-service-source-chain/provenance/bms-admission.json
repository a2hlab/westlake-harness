  "findings": [
    {
      "id": "service",
      "statement": "service maps to SERVICE. It is a privilege extension, not a member of the empty system-extension set. Missing effective allowUsePrivilegeExtension fails HAP parsing with ERR_APPEXECFWK_PARSE_PROFILE_PROP_CHECK_ERROR; system-app status alone is not the predicate in that branch.",
      "evidence": [
        "types",
        "sets",
        "default",
        "checker",
        "installer"
      ]
    },
    {
      "id": "capability",
      "statement": "Default capability false; provision appPrivilegeCapabilities string AllowAppUsePrivilegeExtension enables it. Signature-matched preinstall capability allowAppUsePrivilegeExtension has priority when explicitly present, and can override provision. Without USE_PRE_BUNDLE_PROFILE the parser explicitly enables privilege extensions. GN declares use_pre_bundle_profile=true, but deployed build args are unbound.",
      "evidence": [
        "default",
        "checker",
        "gn",
        "build"
      ]
    },
    {
      "id": "app_service",
      "statement": "appService maps to APP_SERVICE; neither privilege nor system extension sets include it, so those two install predicates do not reject this type. This does not prove complete install/start/connect eligibility. BundleType::APP_SERVICE_FWK is a different enum and its installer restrictions must not be substituted for extension APP_SERVICE.",
      "evidence": [
        "types",
        "sets",
        "checker",
        "parser"
      ]
    },
    {
      "id": "permissions_acl",
      "statement": "The target parser copies permissions, appIdentifierAllowList and visible into extension metadata. readPermission/writePermission are copied only for system+preinstall apps. These copy branches are not an extension registration rejection; the reviewed type gates consume privilege capability, not a named requestPermission or an access-token ACL. General permission verification and runtime caller authorization are not certified by this subreview.",
      "evidence": [
        "parser",
        "checker"
      ]
    }
  ],
  "unknowns": [
    "Actual deployed BMS ELF binding to these source bytes and 14-file patch",
    "Effective deployed use_pre_bundle_profile build argument",
    "Target signed provision capability and matching installed preinstall capability entry",
    "Runtime caller/target connect and start permission checks (peer scope); complete generic installation eligibility"
  ],
