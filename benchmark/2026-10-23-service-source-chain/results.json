      "condition": "BMS must resolve registered target and correct service type. Normal SERVICE request cannot name arbitrary extensions.",
      "failure": "RESOLVE_ABILITY_ERR -> 16000001; TARGET_ABILITY_NOT_SERVICE / ERR_WRONG_INTERFACE_CALL -> 16000002"
    },
    {
      "id": "static-permission",
      "refs": [
        "ams",
        "permission"
      ],
      "condition": "For an ordinary cross-token caller, target permission list must be empty or every permission granted (existing START_INVISIBLE_ABILITY exception is source behavior, not a proposed grant). Same-token early return is distinct. Requested permissions are not grants.",
      "failure": "ERR_STATIC_CFG_PERMISSION -> 16000005"
    },
    {
      "id": "visibility",
      "refs": [
        "permission",
        "ams"
      ],
      "condition": "Target visible, or same token, or actual START_INVISIBLE_ABILITY authorization. No such elevated grant is established for current host.",
      "failure": "ABILITY_VISIBLE_FALSE_DENY_REQUEST -> 16000004"
    },
    {
      "id": "background",
      "refs": [
        "ams",
        "permission"
      ],
      "condition": "Ordinary SERVICE sets isBackgroundCall=false here; isParamStartAbilityEnable_ may independently reject API>=12 background cross-app UI-only callers under ShouldPreventStartAbility. Foreground passes that particular branch, not all policy.",
      "failure": "CHECK_PERMISSION_FAILED -> 201"
    },
    {
      "id": "policy",
      "refs": [
        "ams",
        "extension-caller",
        "other-app-interceptor",
        "extension-permissions"
      ],
      "condition": "Forbid-start, DLP build flag, before/after interceptors, user availability, service manager and preload errors still propagate. Normal UIAbility is not subject to the other-extension caller restriction; StartOtherApp isWithUI=false returns early. No claim that installed configuration passes every interceptor.",
      "failure": "Actual native error propagated; see errors map"
    }
