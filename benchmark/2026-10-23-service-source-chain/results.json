  "admission": [
    {
      "id": "user",
      "refs": [
        "ams",
        "connections"
      ],
      "condition": "Same-user ordinary route has no blanket system-app check. SERVICE cross-user calls invoke CHECK_CALLER_IS_SYSTEM_APP; IsCrossUserCall and GetValidUserId determine the actual case.",
      "failure": "ERR_NOT_SYSTEM_APP -> 202"
    },
    {
      "id": "resolve-type",
      "refs": [
        "ams",
        "resolve"
