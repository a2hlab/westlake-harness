  "next_step_single_proposal": {
    "status": "PROPOSAL_ONLY_NOT_IMPLEMENTED_OR_AUTHORIZED",
    "object": "Owned service lifecycle admission at boot-entry/entry boundary",
    "proposal": "Expose a narrowly authenticated normal host lifecycle request to an owned service only after its supported platform interface and permissions are evidenced; reuse existing strict launch checks. Refusal/unknown remains terminal pending explicit reviewed reconciliation, repeated requests must not create duplicate children or overwrite the old attempt.",
