+    if (bytes.size() >= 4 && std::memcmp(bytes.data(), "RIFF", 4) == 0) {
+        if (bytes.size() < 20 || std::memcmp(bytes.data() + 8, "WEBP", 4) != 0) {
+            return "invalid-webp-header";
+        }
+        const uint32_t riffSize = ReadLe32(bytes, 4);
+        if (static_cast<uint64_t>(riffSize) + 8 != bytes.size()) {
+            return "invalid-webp-riff-size";
+        }
+        const uint32_t chunkSize = ReadLe32(bytes, 16);
+        if (static_cast<uint64_t>(chunkSize) + (chunkSize & 1u) > bytes.size() - 20) {
+            return "truncated-webp-first-chunk";
+        }
+        if (std::memcmp(bytes.data() + 12, "VP8X", 4) == 0 && chunkSize == 10) {
+            return nullptr;
+        }
