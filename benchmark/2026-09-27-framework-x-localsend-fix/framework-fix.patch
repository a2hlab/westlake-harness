diff --git a/framework/core/java/LocalServiceBinders.java b/framework/core/java/LocalServiceBinders.java
index e0df9e6..2a1faf7 100644
--- a/framework/core/java/LocalServiceBinders.java
+++ b/framework/core/java/LocalServiceBinders.java
@@ -51,6 +51,13 @@ public final class LocalServiceBinders {
         if (binder != null) return binder;
         try {
             switch (name) {
+                // #48 X/Twitter: no-op ITelephonyRegistry (loaded by name at runtime, no compile dep).
+                // listen/listenWithEventList/listenForSubscriber and all methods answer the type
+                // default, so PhoneStateListener registration succeeds without a radio and never NPEs.
+                case "telephony.registry":
+                    binder = proxy(name, "com.android.internal.telephony.ITelephonyRegistry",
+                            (call, args) -> DEFAULT);
+                    break;
                 case "uimode":
                     binder = proxy(name, "android.app.IUiModeManager", LocalServiceBinders::uiMode);
                     break;
