             case "game":
diff --git a/framework/package-manager/java/ApplicationMetaDataReader.java b/framework/package-manager/java/ApplicationMetaDataReader.java
index 4a858b0..895f0cb 100644
--- a/framework/package-manager/java/ApplicationMetaDataReader.java
