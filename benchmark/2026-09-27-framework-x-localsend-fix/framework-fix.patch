@@ -42,6 +42,12 @@ final class ApplicationMetaDataReader {
                 result.putString(key, String.valueOf(value));
             }
         }
+        // #48 horizontal (LocalSend/Flutter): OH's GLES driver returns NULL via eglGetProcAddress
