# Fill with the 5ea34a45 base-runtime candidate paths (same set launch-webview10.sh / the probe
# wrapper uses). SERIAL is hard-checked by sweep_app.sh; do NOT point it at another board.
export HDC=/path/to/hdc
export SERIAL=5ea34a4500000000000000001123012c
export PROBE=/home/zhaoyue/a2hlab/manifest/tools/probe_source_app.py
export WORKSPACE=/home/zhaoyue/a2hlab/ws/<sweep-workspace>
export WESTLAKE_SOURCE=/home/zhaoyue/a2hlab/ws/westlake            # or the staged 5ea34a45 source
export FRAMEWORK_REPORT=/home/zhaoyue/a2hlab/ws/<...>/framework-diag/device-report.json
export HOST_BUILD=/home/zhaoyue/a2hlab/ws/<...>/signed-host
export WEBVIEW_INPUT=/home/zhaoyue/a2hlab/ws/<...>/webview-input-source
export SOURCE_WEBVIEW_BUILD=/home/zhaoyue/a2hlab/ws/<...>/candidate-default
export APP_INPUT_ROOT=/home/zhaoyue/a2hlab/app-inputs
export OUT_ROOT=/home/zhaoyue/a2hlab/ws/out-appsweep-5ea34a45
export WAIT=30
