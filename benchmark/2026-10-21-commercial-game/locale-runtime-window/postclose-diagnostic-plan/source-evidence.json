      },
      {
        "line": 161,
        "text": "    AppSpawnedProcess *appInfo = GetSpawnedProcess(pid);"
      },
      {
        "line": 162,
        "text": "    if (appInfo == NULL) { // If an exception occurs during app spawning, kill pid, return failed"
      },
      {
        "line": 163,
        "text": "        WaitChildDied(pid);"
      },
      {
        "line": 164,
        "text": "        DumpStatus(\"unknown\", pid, status, &signal);"
