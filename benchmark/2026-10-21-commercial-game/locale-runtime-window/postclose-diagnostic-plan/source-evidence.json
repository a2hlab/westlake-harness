        "line": 180,
        "text": "    APPSPAWN_DUMPI(\"ProcessSignal signum %{public}d %{public}d\", siginfo->ssi_signo, siginfo->ssi_pid);"
      },
      {
        "line": 181,
        "text": "    switch (siginfo->ssi_signo) {"
      },
