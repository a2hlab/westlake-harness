      },
      {
        "line": 167,
        "text": ""
      },
      {
        "line": 168,
        "text": "    appInfo->exitStatus = status;"
      },
      {
        "line": 169,
        "text": "    APPSPAWN_CHECK_ONLY_LOG(appInfo->uid == uid, \"Invalid uid %{public}u %{public}u\", appInfo->uid, uid);"
      },
      {
        "line": 170,
        "text": "    DumpStatus(appInfo->name, pid, status, &signal);"
      },
