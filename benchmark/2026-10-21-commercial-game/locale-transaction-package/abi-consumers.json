    "lines": [
      {
        "line": 345,
        "text": "    if (flutter_private || native_private) {"
      },
      {
        "line": 346,
        "text": "        /* OH 6.1 musl ignores DF_1_GLOBAL: its add_syms/removal is controlled"
      },
      {
        "line": 347,
        "text": "         * by dlopen mode. Promote only the declared ABI DSO in selected app"
      },
      {
        "line": 348,
        "text": "         * domains, not arbitrary app libraries or system providers. */"
      },
      {
        "line": 349,
        "text": "        const char* abi = flutter_private"
      },
      {
        "line": 350,
        "text": "            ? \"/system/android/lib64/westlake_flutter/libwestlake_native_abi.so\""
      },
      {
        "line": 351,
        "text": "            : \"/system/android/lib64/westlake_native/libwestlake_native_abi.so\";"
      },
      {
        "line": 352,
        "text": "        void* handle = dlopen_ns(app_namespace, abi, RTLD_NOW | RTLD_GLOBAL);"
      },
      {
        "line": 353,
        "text": "        if (handle == NULL) return NamespaceResultFence(ENOENT);"
      },
      {
        "line": 354,
        "text": "        fprintf(stderr, \"[N2-OWNER] %s ABI global ready; search=%s permitted=%s\\n\","
      },
      {
        "line": 355,
        "text": "                app_name, app_search_paths, app_permitted_paths);"
      }
    ]
  },
