        "sha256": "f7fdc279967a070931244e12f8dfdd1978ae27910f1749e2e1bf4628221b4f94",
        "bytes": 243,
        "text_sanitized": "{\n  \"argv\": [\n    \"orbctl\",\n    \"start\",\n    \"--help\"\n  ],\n  \"cwd\": \"$WORKSPACES/westlake-harness-g10-env\",\n  \"start\": 1792571966.648559,\n  \"end\": 1792571966.65571,\n  \"rc\": 0,\n  \"timeout_seconds\": 15,\n  \"timed_out\": false\n}\n"
      },
      ".stdout": {
