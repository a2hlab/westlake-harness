+    constexpr size_t MAX_ZIP_COMMENT_LEN = 0xFFFF;
+    size_t windowLen = (fileLength_ < endDirLen + MAX_ZIP_COMMENT_LEN) ?
+        fileLength_ : (endDirLen + MAX_ZIP_COMMENT_LEN);
+    std::string window(windowLen, '\0');
+    if (fseek(file_, endFilePos - windowLen, SEEK_SET) != 0) {
+        APP_LOGE("locate EOCD scan window seek failed, error: %{public}d", errno);
+        return false;
