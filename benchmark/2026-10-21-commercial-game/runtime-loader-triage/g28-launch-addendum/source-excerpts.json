  {
    "path": "$WORKSPACES/westlake-harness-bms-deploy/bms/src/adapter/framework/appspawn-x/bionic_compat/src/unity_libc_stubs.c",
    "sha256": "20ceddfc3c3b68d6873a9c1ed2a028f3111d283c8418ced501dc2fab61b8a8a2",
