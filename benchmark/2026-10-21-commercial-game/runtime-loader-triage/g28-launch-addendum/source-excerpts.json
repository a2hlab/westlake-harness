      {
        "line": 1,
        "text": "// Exact Bionic locale/ctype ABI required by the unmodified ZigZag arm64 DSOs."
      },
      {
        "line": 2,
        "text": "//"
      },
      {
        "line": 3,
        "text": "// AOSP16 implements strtoll_l/strtoull_l as strong aliases of strtoll/strtoull,"
      },
      {
        "line": 4,
        "text": "// so the locale argument is intentionally ignored here as well.  `_ctype_` is"
      },
      {
        "line": 5,
        "text": "// the historical Bionic/OpenBSD pointer ABI: consumers load the exported"
      },
      {
        "line": 6,
        "text": "// pointer, then index the 257-byte C-locale classification table at c + 1."
      },
      {
        "line": 7,
        "text": ""
      },
      {
        "line": 8,
        "text": "#include <locale.h>"
      },
      {
        "line": 9,
        "text": "#include <stdlib.h>"
      },
      {
        "line": 10,
        "text": ""
      },
      {
        "line": 11,
        "text": "long long strtoll_l(const char *nptr, char **endptr, int base, locale_t locale)"
      },
      {
        "line": 12,
        "text": "{"
      },
      {
        "line": 13,
        "text": "    (void)locale;"
      },
      {
        "line": 14,
        "text": "    return strtoll(nptr, endptr, base);"
      },
      {
        "line": 15,
        "text": "}"
      },
      {
        "line": 16,
        "text": ""
      },
      {
        "line": 17,
        "text": "unsigned long long strtoull_l("
      },
      {
        "line": 18,
        "text": "    const char *nptr, char **endptr, int base, locale_t locale)"
      },
      {
        "line": 19,
        "text": "{"
      },
      {
        "line": 20,
        "text": "    (void)locale;"
      },
      {
        "line": 21,
        "text": "    return strtoull(nptr, endptr, base);"
      },
      {
        "line": 22,
        "text": "}"
      },
      {
        "line": 23,
        "text": ""
      },
      {
        "line": 24,
        "text": "#define BIONIC_CT_U 0x01"
      },
      {
