    "lines": [
      {
        "line": 100,
        "text": "// 8) _ctype_  (unity)  [UNITY-LIBC-STUB]  -- BSD ctype classification table."
      },
      {
        "line": 101,
        "text": "//    DATA symbol, NOT a function. musl/OH libc.so does not export it."
      },
      {
        "line": 102,
        "text": "//"
      },
      {
        "line": 103,
        "text": "//    ABI note (verified by disassembling PackageEscort libunity.so):"
      },
      {
        "line": 104,
        "text": "//      adrp x9,_ctype_GOT ; ldr x9,[x9]      ; x9 = &_ctype_   (the symbol addr)"
      },
      {
        "line": 105,
        "text": "//      ldr  x9,[x9]                          ; x9 = *_ctype_   <-- DEREFERENCE"
      },
      {
        "line": 106,
        "text": "//      add  x12,x9,char ; ldrb w12,[x12,#1]  ; class = base[char+1]"
      },
      {
        "line": 107,
        "text": "//    i.e. the consumer treats `_ctype_` as a POINTER (load value, then deref),"
      },
      {
        "line": 108,
        "text": "//    exactly like bionic's `const char *_ctype_ = _C_ctype_;`. A bare"
      },
      {
        "line": 109,
        "text": "//    `const char _ctype_[]` array would be loaded-then-WRONGLY-dereferenced"
      },
      {
        "line": 110,
        "text": "//    (first 8 table bytes used as a pointer) -> crash. So we replicate bionic:"
      },
      {
        "line": 111,
        "text": "//    a 257-byte table (_C_ctype_) + a `_ctype_` POINTER to it. base[0] is the"
      },
      {
        "line": 112,
        "text": "//    EOF slot; base[c+1] is char c's class. The verbatim table below is the"
      },
      {
        "line": 113,
        "text": "//    OpenBSD/bionic _C_ctype_ (bionic/libc/upstream-openbsd/.../gen/ctype_.c);"
      },
      {
        "line": 114,
        "text": "//    bytes 0x80..0xFF are 0 (ASCII-only classification, as bionic ships)."
      },
      {
        "line": 115,
        "text": "//"
      },
      {
        "line": 116,
        "text": "//    `_ctype_` shows in `llvm-nm -D` as `D _ctype_` (GLOBAL OBJECT in .data)."
      },
      {
        "line": 117,
        "text": "// ---------------------------------------------------------------------------"
      },
      {
        "line": 118,
        "text": "#define _CT_U 0x01  /* upper */"
      },
      {
        "line": 119,
        "text": "#define _CT_L 0x02  /* lower */"
      },
      {
        "line": 120,
        "text": "#define _CT_N 0x04  /* digit */"
      },
      {
        "line": 121,
        "text": "#define _CT_S 0x08  /* space */"
      },
      {
        "line": 122,
        "text": "#define _CT_P 0x10  /* punct */"
      },
      {
        "line": 123,
        "text": "#define _CT_C 0x20  /* control */"
      },
      {
        "line": 124,
        "text": "#define _CT_X 0x40  /* hex digit */"
      },
      {
        "line": 125,
        "text": "#define _CT_B 0x80  /* blank (printable space) */"
      },
      {
        "line": 126,
        "text": ""
      },
      {
        "line": 127,
        "text": "const char _C_ctype_[1 + 256] = {"
      },
      {
        "line": 128,
        "text": "    0,"
      },
      {
        "line": 129,
        "text": "    _CT_C, _CT_C, _CT_C, _CT_C, _CT_C, _CT_C, _CT_C, _CT_C,"
      },
      {
        "line": 130,
        "text": "    _CT_C, _CT_C|_CT_S, _CT_C|_CT_S, _CT_C|_CT_S, _CT_C|_CT_S, _CT_C|_CT_S, _CT_C, _CT_C,"
      },
      {
        "line": 131,
        "text": "    _CT_C, _CT_C, _CT_C, _CT_C, _CT_C, _CT_C, _CT_C, _CT_C,"
      },
      {
        "line": 132,
        "text": "    _CT_C, _CT_C, _CT_C, _CT_C, _CT_C, _CT_C, _CT_C, _CT_C,"
      },
      {
        "line": 133,
        "text": "    _CT_S|(char)_CT_B, _CT_P, _CT_P, _CT_P, _CT_P, _CT_P, _CT_P, _CT_P,"
      },
      {
        "line": 134,
        "text": "    _CT_P, _CT_P, _CT_P, _CT_P, _CT_P, _CT_P, _CT_P, _CT_P,"
      },
      {
        "line": 135,
        "text": "    _CT_N, _CT_N, _CT_N, _CT_N, _CT_N, _CT_N, _CT_N, _CT_N,"
      },
      {
        "line": 136,
        "text": "    _CT_N, _CT_N, _CT_P, _CT_P, _CT_P, _CT_P, _CT_P, _CT_P,"
      },
      {
        "line": 137,
        "text": "    _CT_P, _CT_U|_CT_X, _CT_U|_CT_X, _CT_U|_CT_X, _CT_U|_CT_X, _CT_U|_CT_X, _CT_U|_CT_X, _CT_U,"
      },
      {
        "line": 138,
        "text": "    _CT_U, _CT_U, _CT_U, _CT_U, _CT_U, _CT_U, _CT_U, _CT_U,"
      },
      {
        "line": 139,
        "text": "    _CT_U, _CT_U, _CT_U, _CT_U, _CT_U, _CT_U, _CT_U, _CT_U,"
      },
      {
        "line": 140,
        "text": "    _CT_U, _CT_U, _CT_U, _CT_P, _CT_P, _CT_P, _CT_P, _CT_P,"
      },
      {
        "line": 141,
        "text": "    _CT_P, _CT_L|_CT_X, _CT_L|_CT_X, _CT_L|_CT_X, _CT_L|_CT_X, _CT_L|_CT_X, _CT_L|_CT_X, _CT_L,"
      },
      {
        "line": 142,
        "text": "    _CT_L, _CT_L, _CT_L, _CT_L, _CT_L, _CT_L, _CT_L, _CT_L,"
      },
      {
        "line": 143,
        "text": "    _CT_L, _CT_L, _CT_L, _CT_L, _CT_L, _CT_L, _CT_L, _CT_L,"
      },
      {
        "line": 144,
        "text": "    _CT_L, _CT_L, _CT_L, _CT_P, _CT_P, _CT_P, _CT_P, _CT_C,"
      },
      {
        "line": 145,
        "text": "    0, 0, 0, 0, 0, 0, 0, 0,  /* 0x80 */"
      },
      {
        "line": 146,
        "text": "    0, 0, 0, 0, 0, 0, 0, 0,"
      },
      {
        "line": 147,
        "text": "    0, 0, 0, 0, 0, 0, 0, 0,  /* 0x90 */"
      },
      {
        "line": 148,
        "text": "    0, 0, 0, 0, 0, 0, 0, 0,"
      },
      {
        "line": 149,
        "text": "    0, 0, 0, 0, 0, 0, 0, 0,  /* 0xA0 */"
      },
      {
        "line": 150,
        "text": "    0, 0, 0, 0, 0, 0, 0, 0,"
      },
