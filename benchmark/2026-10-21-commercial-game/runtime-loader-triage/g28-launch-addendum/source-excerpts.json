        "text": "    BIONIC_CT_U, BIONIC_CT_U, BIONIC_CT_U, BIONIC_CT_P, BIONIC_CT_P, BIONIC_CT_P, BIONIC_CT_P, BIONIC_CT_P,"
      },
      {
