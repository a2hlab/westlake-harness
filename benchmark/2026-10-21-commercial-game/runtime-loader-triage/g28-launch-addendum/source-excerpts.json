        "line": 151,
        "text": "    0, 0, 0, 0, 0, 0, 0, 0,  /* 0xB0 */"
      },
      {
        "line": 152,
        "text": "    0, 0, 0, 0, 0, 0, 0, 0,"
      },
      {
        "line": 153,
        "text": "    0, 0, 0, 0, 0, 0, 0, 0,  /* 0xC0 */"
      },
      {
        "line": 154,
        "text": "    0, 0, 0, 0, 0, 0, 0, 0,"
