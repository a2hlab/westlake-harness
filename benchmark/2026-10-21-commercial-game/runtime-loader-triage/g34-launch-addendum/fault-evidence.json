      "text": "    Performs a non-blocking read and exits when all logs in buffer are printed."
    },
    {
      "line": 10,
      "text": "  -a <n>, --head=<n>"
    },
    {
      "line": 11,
      "text": "    Show n lines logs on head of buffer."
    },
    {
      "line": 12,
      "text": "  -z <n>, --tail=<n>"
    },
    {
      "line": 13,
      "text": "    Show n lines logs on tail of buffer."
    },
    {
      "line": 14,
      "text": "  -t <type>, --type=<type>"
    },
    {
      "line": 15,
      "text": "    Show specific type/types logs with format: type1,type2,type3"
    },
    {
      "line": 16,
      "text": "    Don't show specific type/types logs with format: ^type1,type2,type3"
    },
    {
