        "line": 103,
        "text": "extern \"C\" __attribute__((visibility(\"default\")))"
      },
      {
        "line": 104,
        "text": "EGLSurface eglCreateWindowSurface(EGLDisplay dpy, EGLConfig config,"
      },
      {
        "line": 105,
        "text": "                                   EGLNativeWindowType window,"
      },
      {
        "line": 106,
        "text": "                                   const EGLint* attrib_list) {"
      },
      {
        "line": 107,
        "text": "    resolve_egl_hijack_funcs();"
      },
      {
        "line": 108,
        "text": ""
      },
      {
        "line": 109,
        "text": "    EGLNativeWindowType actualWindow = window;"
      },
      {
        "line": 110,
        "text": "    if (g_oh_anw_get_oh_fn && window) {"
      },
      {
        "line": 111,
        "text": "        void* unwrapped = g_oh_anw_get_oh_fn(window);"
      },
      {
        "line": 112,
        "text": "        if (unwrapped) {"
      },
      {
        "line": 113,
        "text": "            n6_log(3, 4, 0xD000F00, \"OH_EglHijack\","
      },
      {
        "line": 114,
        "text": "                       \"eglCreateWindowSurface: detected ANW shim %p, \""
      },
      {
        "line": 115,
        "text": "                       \"unwrapped to OH NativeWindow=%p\","
      },
      {
        "line": 116,
        "text": "                       window, unwrapped);"
      },
      {
        "line": 117,
        "text": "            actualWindow = (EGLNativeWindowType) unwrapped;"
      },
      {
        "line": 118,
        "text": "        }"
      },
      {
        "line": 119,
        "text": "    }"
      },
      {
        "line": 120,
        "text": ""
      },
      {
        "line": 121,
        "text": "    if (!g_real_eglCreateWindowSurface_fn) {"
      },
      {
        "line": 122,
        "text": "        n6_log(3, 7, 0xD000F00, \"OH_EglHijack\","
      },
      {
        "line": 123,
        "text": "                   \"eglCreateWindowSurface: libEGL.so eglCreateWindowSurface \""
      },
      {
        "line": 124,
        "text": "                   \"not resolved — returning EGL_NO_SURFACE\");"
      },
      {
        "line": 125,
        "text": "        return EGL_NO_SURFACE;"
      },
      {
        "line": 126,
        "text": "    }"
      },
      {
        "line": 127,
        "text": ""
      },
      {
        "line": 128,
        "text": "    EGLSurface surface = g_real_eglCreateWindowSurface_fn("
      },
      {
        "line": 129,
        "text": "        dpy, config, actualWindow, attrib_list);"
      },
      {
        "line": 130,
        "text": "    if (surface != EGL_NO_SURFACE && actualWindow != window &&"
      },
      {
        "line": 131,
        "text": "        g_oh_anw_notify_presented_fn) {"
      },
      {
        "line": 132,
        "text": "        std::lock_guard<std::mutex> lock(g_egl_surface_owner_mutex);"
      },
      {
        "line": 133,
        "text": "        g_egl_surface_owner[surface] = window;"
      },
      {
        "line": 134,
        "text": "    }"
      },
      {
        "line": 135,
        "text": "    n6_log(3, 4, 0xD000F00, \"OH_EglHijack\","
      },
      {
        "line": 136,
        "text": "               \"eglCreateWindowSurface: dpy=%p config=%p window=%p (orig=%p) \""
      },
      {
        "line": 137,
        "text": "               \"-> EGLSurface=%p\","
      },
      {
        "line": 138,
        "text": "               dpy, config, actualWindow, window, surface);"
      },
      {
        "line": 139,
        "text": "    return surface;"
      },
      {
        "line": 140,
        "text": "}"
      }
    ]
  },
