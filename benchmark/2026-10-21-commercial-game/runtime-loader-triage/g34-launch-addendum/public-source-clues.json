        "line": 301,
        "text": "static __eglMustCastToProperFunctionPointerType FindBuiltinWrapper(const char* procname)"
      },
      {
        "line": 302,
        "text": "{"
      },
      {
        "line": 303,
        "text": "#if (defined(__aarch64__) || defined(__x86_64__))"
      },
      {
        "line": 304,
        "text": "    static void* dlglv3Handle = dlopen(\"/system/lib64/libGLESv3.so\", RTLD_NOW | RTLD_LOCAL);"
      },
      {
        "line": 305,
        "text": "#else"
      },
      {
        "line": 306,
        "text": "    static void* dlglv3Handle = dlopen(\"/system/lib/platformsdk/libGLESv3.so\", RTLD_NOW | RTLD_LOCAL);"
      },
      {
        "line": 307,
        "text": "#endif"
      },
      {
        "line": 308,
        "text": "    if (dlglv3Handle == nullptr) {"
      },
      {
        "line": 309,
        "text": "        WLOGE(\"Failed to load GLES library using dl open\");"
      },
      {
        "line": 310,
        "text": "        return nullptr;"
      },
      {
        "line": 311,
        "text": "    }"
      },
      {
        "line": 312,
        "text": "    void* proc = dlsym(dlglv3Handle, procname);"
      },
      {
        "line": 313,
        "text": "    if (proc) {"
      },
      {
        "line": 314,
        "text": "        return (__eglMustCastToProperFunctionPointerType)proc;"
      },
      {
        "line": 315,
        "text": "    }"
      },
      {
        "line": 316,
        "text": "    return nullptr;"
      },
      {
        "line": 317,
        "text": "}"
      },
      {
        "line": 318,
        "text": ""
      },
      {
        "line": 319,
        "text": "__eglMustCastToProperFunctionPointerType EglGetProcAddressImpl(const char *procname)"
      },
      {
        "line": 320,
        "text": "{"
      },
      {
        "line": 321,
        "text": "    ClearError();"
      },
      {
        "line": 322,
        "text": "    WLOGD(\"\");"
      },
      {
        "line": 323,
        "text": "    if (gExtensionMap.find(procname) != gExtensionMap.end()) {"
      },
      {
        "line": 324,
        "text": "        return gExtensionMap.at(procname);"
      },
      {
        "line": 325,
        "text": "    }"
      },
      {
        "line": 326,
        "text": ""
      },
      {
        "line": 327,
        "text": "    __eglMustCastToProperFunctionPointerType addr = FindBuiltinWrapper(procname);"
      },
      {
        "line": 328,
        "text": "    if (addr) {"
      },
      {
        "line": 329,
        "text": "        return __eglMustCastToProperFunctionPointerType(addr);"
      },
      {
        "line": 330,
        "text": "    }"
      },
      {
        "line": 331,
        "text": ""
      },
      {
        "line": 332,
        "text": "    EglWrapperLoader& loader(EglWrapperLoader::GetInstance());"
      },
      {
        "line": 333,
        "text": "    void *func = loader.GetProcAddrFromDriver(procname);"
      },
      {
        "line": 334,
        "text": ""
      },
      {
        "line": 335,
        "text": "    if (!func) {"
      },
      {
        "line": 336,
        "text": "        EglWrapperDispatchTablePtr table = &gWrapperHook;"
      },
      {
        "line": 337,
        "text": "        if (table->isLoad && table->egl.eglGetProcAddress) {"
      },
      {
        "line": 338,
        "text": "            func = reinterpret_cast<void *>(table->egl.eglGetProcAddress(procname));"
      },
      {
        "line": 339,
        "text": "        }"
      },
      {
        "line": 340,
        "text": "    }"
      },
      {
        "line": 341,
        "text": ""
      },
      {
        "line": 342,
        "text": "    if (func) {"
      },
      {
        "line": 343,
        "text": "        return __eglMustCastToProperFunctionPointerType(func);"
      },
      {
        "line": 344,
        "text": "    }"
      },
      {
        "line": 345,
        "text": ""
      },
      {
        "line": 346,
        "text": "#ifdef OPENGL_WRAPPER_ENABLE_GL4"
      },
      {
        "line": 347,
        "text": "    auto it = gCustomMap.find(procname);"
      },
      {
        "line": 348,
        "text": "    if (it != gCustomMap.end()) {"
      },
      {
        "line": 349,
        "text": "        return __eglMustCastToProperFunctionPointerType(it->second);"
      },
      {
        "line": 350,
        "text": "    }"
      },
      {
        "line": 351,
        "text": "#endif"
      },
      {
        "line": 352,
        "text": "    WLOGD(\"FindEglExtApi did not find an entry for %{public}s\", procname);"
      },
      {
        "line": 353,
        "text": "    return nullptr;"
      }
