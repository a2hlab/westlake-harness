      },
      {
        "line": 68,
        "text": "    for (size_t i=0; i<sizeof(packages)/sizeof(packages[0]); ++i) {"
      },
      {
        "line": 69,
        "text": "        const char* q=text;"
      },
      {
        "line": 70,
        "text": "        while ((q=strstr(q, packages[i])) != NULL) {"
      },
      {
        "line": 71,
        "text": "            size_t n=strlen(packages[i]);"
      },
      {
        "line": 72,
        "text": "            if ((q==text || q[-1]=='/') && (q[n]=='/' || q[n]==':' || q[n]=='\\0')) return true;"
      },
      {
        "line": 73,
        "text": "            q+=n;"
      },
      {
        "line": 74,
        "text": "        }"
      },
      {
        "line": 75,
        "text": "    }"
      },
      {
        "line": 76,
        "text": "    return false;"
      },
      {
        "line": 77,
        "text": "}"
      },
      {
        "line": 78,
        "text": ""
      },
      {
        "line": 79,
        "text": "/* G26: exact package component, matching the existing selector boundaries. */"
      },
      {
        "line": 80,
        "text": "static bool genshin_package_path(const char* text) {"
      },
      {
        "line": 81,
        "text": "    const char* package = \"com.miHoYo.Yuanshen\";"
      },
      {
        "line": 82,
        "text": "    const size_t n = strlen(package);"
      },
      {
        "line": 83,
        "text": "    const char* p = text;"
      },
      {
        "line": 84,
        "text": "    while ((p = strstr(p, package)) != NULL) {"
      },
      {
        "line": 85,
        "text": "        if ((p == text || p[-1] == '/') &&"
      },
      {
        "line": 86,
        "text": "            (p[n] == '/' || p[n] == ':' || p[n] == '\\0')) return true;"
      },
      {
        "line": 87,
        "text": "        p += n;"
      },
      {
        "line": 88,
        "text": "    }"
      },
      {
        "line": 89,
        "text": "    return false;"
      },
      {
        "line": 90,
        "text": "}"
      }
    ]
