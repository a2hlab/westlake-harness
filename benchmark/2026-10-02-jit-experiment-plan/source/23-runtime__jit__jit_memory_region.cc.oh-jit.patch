# OH JIT fallback, ported from Westlake aosp-art-15 (a2hlab ~/a2hlab/ws/aosp-art-15 @047ccf0, file e4b63405) to
# AOSP 14 art-r1 (3c05e56adf): block copied verbatim, gPageSize -> kPageSize (AOSP 14 has no runtime page size).
# RECORD ONLY: board libart 59e1bb45 has no recoverable source (DIGEST 502), so this cannot be applied to it
# without rebuilding libart from r1+series (not single-variable). The experiment reaches the same anonymous
# fallback with jit_anon_shim.c instead.
--- a/runtime/jit/jit_memory_region.cc
+++ b/runtime/jit/jit_memory_region.cc
@@ -16,7 +16,10 @@
 
 #include "jit_memory_region.h"
 
+#include <cerrno>
+#include <cstdlib>
 #include <fcntl.h>
+#include <sys/stat.h>
 #include <unistd.h>
 
 #include <android-base/unique_fd.h>
@@ -100,6 +103,64 @@
       return false;
     }
   }
+
+#if defined(__OHOS__)
+  // OH app domains can create and write memfd files while denying executable
+  // mappings of their tmpfs label. Probe that capability before constructing
+  // dual views. Opt in per launch, and honor ART's existing RWX policy: only
+  // ordinary private caches may use its anonymous RX/RWX update path. Zygote
+  // sharing and callers that prohibit RWX retain the normal failure behavior.
+  const char* anonymous_fallback = getenv("WESTLAKE_OH_JIT_ANON_FALLBACK");
+  if (!is_zygote && rwx_memory_allowed && exec_capacity > 0 && mem_fd.get() >= 0 &&
+      anonymous_fallback != nullptr && strcmp(anonymous_fallback, "1") == 0) {
+    void* probe = mmap(nullptr, kPageSize, kProtRX, MAP_SHARED, mem_fd.get(), data_capacity);
+    if (probe == MAP_FAILED) {
+      const int mapping_error = errno;
+      if (mapping_error == EACCES || mapping_error == EPERM) {
+        // OH labels memfd and app-private files differently. An unlinked file
+        // in an explicitly supplied app-owned cache directory can retain ART's
+        // ordinary dual RW/RX views without repeated RX/RWX mprotect calls.
+        // O_TMPFILE leaves no pathname to replace or clean up. Keep this opt-in,
+        // private-cache-only, and subject to the kernel's normal mmap policy.
+        unique_fd file_fd;
+        const char* cache_dir = getenv("WESTLAKE_OH_JIT_FILE_CACHE_DIR");
+        if (cache_dir != nullptr && cache_dir[0] == '/' && geteuid() != 0) {
+          unique_fd dir_fd(open(cache_dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+          struct stat directory_stat {};
+          if (dir_fd.get() >= 0 && fstat(dir_fd.get(), &directory_stat) == 0 &&
+              directory_stat.st_uid == geteuid() && (directory_stat.st_mode & 0077) == 0) {
+            file_fd.reset(openat(dir_fd.get(), ".", O_TMPFILE | O_RDWR | O_CLOEXEC, 0600));
+            if (file_fd.get() >= 0 && ftruncate(file_fd.get(), capacity) == 0) {
+              void* file_probe = mmap(nullptr, kPageSize, kProtRX, MAP_SHARED,
+                                     file_fd.get(), data_capacity);
+              if (file_probe == MAP_FAILED) {
+                file_fd.reset();
+              } else if (munmap(file_probe, kPageSize) != 0) {
+                *error_msg = "Failed to unmap private JIT executable-memory capability probe";
+                return false;
+              }
+            } else {
+              file_fd.reset();
+            }
+          }
+        }
+        if (file_fd.get() >= 0) {
+          mem_fd = std::move(file_fd);
+          LOG(WARNING) << "[WESTLAKE-OH-JIT] memfd RX denied (" << mapping_error
+                       << "); using app-private unlinked file with dual RW/RX views";
+        } else {
+          LOG(WARNING) << "[WESTLAKE-OH-JIT] memfd RX denied (" << mapping_error
+                       << "); using ART anonymous cache with RWX updates permitted by caller";
+          mem_fd.reset();
+        }
+      }
+    } else if (munmap(probe, kPageSize) != 0) {
+      *error_msg = "Failed to unmap JIT executable-memory capability probe";
+      return false;
+    }
+  }
+#endif
+
 
   // Map name specific for android_os_Debug.cpp accounting.
   std::string data_cache_name = is_zygote ? "zygote-data-code-cache" : "data-code-cache";
