  {
    "label": "old",
    "sha256": "b94f69e4c68ad2141a1911040ec0e8b5aafce9cec2fe9fc1f6cf129f5749daea",
    "first_line": 398,
    "lines": [
      {
        "line": 398,
        "text": "static void resolve_oh_wm_funcs() {"
      },
      {
        "line": 399,
        "text": "    static bool s_logged = false;"
      },
      {
        "line": 400,
        "text": "    if (g_oh_wm_get_native_window_fn &&"
      },
      {
        "line": 401,
        "text": "        g_oh_rs_get_child_surface_window_fn) return;"
      },
      {
        "line": 402,
        "text": ""
      },
      {
        "line": 403,
        "text": "    // 2026-05-09 G2.14ac: previous code used dlsym(RTLD_DEFAULT, ...) which on"
      },
      {
        "line": 404,
        "text": "    // OH only searches the caller's linker namespace and the main executable"
      },
      {
        "line": 405,
        "text": "    // (appspawn-x). The target symbols live in liboh_adapter_bridge.so which"
      },
      {
        "line": 406,
        "text": "    // lives in a different namespace, so RTLD_DEFAULT misses them \u2014 dlerror"
      },
      {
        "line": 407,
        "text": "    // confirmed: \"Symbol not found ... so=/system/bin/appspawn-x\"."
      },
      {
        "line": 408,
        "text": "    //"
      },
      {
        "line": 409,
        "text": "    // The runtime has an exact DT_NEEDED edge to liboh_adapter_bridge.so."
      },
      {
        "line": 410,
        "text": "    // Resolve only that already-loaded object. A fresh-by-name/absolute-path"
      },
      {
        "line": 411,
        "text": "    // fallback can create a second namespace instance and split the window"
      },
      {
        "line": 412,
        "text": "    // session state, so a NOLOAD miss is a hard boundary failure."
      },
      {
        "line": 413,
        "text": "    static void* s_bridgeHandle = nullptr;"
      },
      {
        "line": 414,
        "text": "    if (!s_bridgeHandle) {"
      },
      {
        "line": 415,
        "text": "        s_bridgeHandle = dlopen(\"liboh_adapter_bridge.so\", RTLD_NOW | RTLD_NOLOAD);"
      },
      {
        "line": 416,
        "text": "        if (s_bridgeHandle) {"
      },
      {
        "line": 417,
        "text": "            ALOGI(\"[DEBUG] resolve_oh_wm_funcs: exact loaded bridge handle=%p\","
      },
      {
        "line": 418,
        "text": "                  s_bridgeHandle);"
      },
      {
        "line": 419,
        "text": "        } else {"
      },
      {
        "line": 420,
        "text": "            const char* err = dlerror();"
      },
      {
        "line": 421,
        "text": "            ALOGE(\"[DEBUG] resolve_oh_wm_funcs: required loaded bridge absent dlerror='%s'\","
      },
      {
        "line": 422,
        "text": "                  err ? err : \"(null)\");"
      },
      {
        "line": 423,
        "text": "            return;"
      },
      {
        "line": 424,
        "text": "        }"
      },
      {
        "line": 425,
        "text": "    }"
      },
      {
        "line": 426,
        "text": ""
      },
      {
        "line": 427,
        "text": "    if (!g_oh_wm_get_native_window_fn) {"
      },
      {
        "line": 428,
        "text": "        g_oh_wm_get_native_window_fn = reinterpret_cast<oh_wm_get_native_window_fn_t>("
      },
      {
        "line": 429,
        "text": "            dlsym(s_bridgeHandle, \"oh_wm_get_native_window\"));"
      },
      {
        "line": 430,
        "text": "    }"
      },
      {
        "line": 431,
        "text": "    if (!g_oh_rs_get_child_surface_window_fn) {"
      },
      {
        "line": 432,
        "text": "        g_oh_rs_get_child_surface_window_fn = reinterpret_cast<oh_rs_get_child_surface_window_fn_t>("
      },
      {
        "line": 433,
        "text": "            dlsym(s_bridgeHandle, \"oh_rs_get_child_surface_window\"));"
      },
      {
        "line": 434,
        "text": "    }"
      },
      {
        "line": 435,
        "text": "    if (!s_logged) {"
      }
    ]
  },
  {
    "label": "old",
    "sha256": "b94f69e4c68ad2141a1911040ec0e8b5aafce9cec2fe9fc1f6cf129f5749daea",
