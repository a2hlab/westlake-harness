    "lines": [
      {
        "line": 1309,
        "text": "//"
      },
      {
        "line": 1310,
        "text": "// libEGL.so is an exact DT_NEEDED dependency of this runtime. Reuse only the"
      },
      {
        "line": 1311,
        "text": "// already-loaded provider; never create a second/global/absolute-path instance."
      },
      {
        "line": 1312,
        "text": "typedef void*    EGLDisplay;"
      },
      {
        "line": 1313,
        "text": "typedef void*    EGLConfig;"
      },
      {
        "line": 1314,
        "text": "typedef void*    EGLSurface;"
      },
      {
        "line": 1315,
        "text": "typedef int32_t  EGLint;"
      },
      {
        "line": 1316,
        "text": "typedef EGLSurface (*PFN_eglCreateWindowSurface)(EGLDisplay, EGLConfig, void*,"
      },
      {
        "line": 1317,
        "text": "                                                 const EGLint*);"
      },
      {
        "line": 1318,
        "text": ""
      },
      {
        "line": 1319,
        "text": "extern \"C\" EGLSurface eglCreateWindowSurface(EGLDisplay dpy, EGLConfig cfg,"
      },
      {
        "line": 1320,
        "text": "                                             void* win, const EGLint* attrs) {"
      },
      {
        "line": 1321,
        "text": "    static PFN_eglCreateWindowSurface s_real = nullptr;"
      },
      {
        "line": 1322,
        "text": "    static bool s_resolved = false;"
      },
      {
        "line": 1323,
        "text": "    if (!s_resolved) {"
      },
      {
        "line": 1324,
        "text": "        s_resolved = true;"
      },
      {
        "line": 1325,
        "text": "        // dlfcn.h was #included inside namespace android above, so the dl*"
      },
      {
        "line": 1326,
        "text": "        // symbols live in android:: \u2014 qualify them from this global scope."
      },
      {
        "line": 1327,
        "text": "        void* h = android::dlopen(\"libEGL.so\", RTLD_NOW | RTLD_NOLOAD);"
      },
      {
        "line": 1328,
        "text": "        if (h) {"
      },
      {
        "line": 1329,
        "text": "            s_real = reinterpret_cast<PFN_eglCreateWindowSurface>("
      },
      {
        "line": 1330,
        "text": "                android::dlsym(h, \"eglCreateWindowSurface\"));"
      },
      {
        "line": 1331,
        "text": "        }"
      },
      {
        "line": 1332,
        "text": "        NWFS_INFO(\"[UNITY-EGL] resolve eglCreateWindowSurface handle=%{public}p real=%{public}p\","
      },
      {
        "line": 1333,
        "text": "                  h, reinterpret_cast<void*>(s_real));"
      },
      {
        "line": 1334,
        "text": "    }"
      },
      {
        "line": 1335,
        "text": "    if (!s_real) {"
      },
      {
        "line": 1336,
        "text": "        NWFS_WARN(\"[UNITY-EGL] real eglCreateWindowSurface unresolved -> EGL_NO_SURFACE\");"
      },
      {
        "line": 1337,
        "text": "        return nullptr;   // EGL_NO_SURFACE"
      },
      {
        "line": 1338,
        "text": "    }"
      },
      {
        "line": 1339,
        "text": "    OHNativeWindow* oh = win ? oh_anw_get_oh(reinterpret_cast<ANativeWindow*>(win))"
      },
      {
        "line": 1340,
        "text": "                             : nullptr;"
      },
      {
        "line": 1341,
        "text": ""
      }
    ]
  },
